---
/**
 * Pulse case study. The page itself lives in CaseStudyLayout; all copy and
 * media placement live in src/content/pulse.ts. The named slots below are
 * the wide media that breaks across the page after the section whose
 * `after` matches.
 */
import { Image } from "astro:assets";
import CaseStudyLayout from "../../components/work/CaseStudyLayout.astro";
import HexBadgeGrid from "../../components/work/pulse/HexBadgeGrid.astro";
import { pulse, badges } from "../../content/pulse";
---

<CaseStudyLayout study={pulse}>
  <HexBadgeGrid slot="badges" badges={badges} />

  <div slot="admin" class="cs__admin-shots">
    {
      pulse.adminShots.map((shot) => (
        <Image
          class="cs__admin-shot"
          src={shot.image}
          alt={shot.alt}
          widths={[480, 640, 960]}
          sizes="(min-width: 700px) 45vw, 90vw"
        />
      ))
    }
  </div>
</CaseStudyLayout>

<style>
  .cs__admin-shots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .cs__admin-shot {
    display: block;
    flex: 1 1 320px;
    /* Let the images shrink below their intrinsic width so the pair can
       sit side by side instead of wrapping. */
    min-width: 0;
    max-width: 100%;
    height: auto;
    border: 6px solid var(--color-ink);
    border-radius: 20px;
    background: var(--color-cream);
  }

</style>
