---
/**
 * Bespoke Pulse case-study page. Static routes win over the generic
 * [slug].astro stub in Astro's router, so this file — not the dynamic
 * route — serves /work/pulse.
 */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackToWork from "../../components/work/BackToWork.astro";
import FilmStrip from "../../components/work/FilmStrip.astro";
import PhoneFrame from "../../components/work/pulse/PhoneFrame.astro";
import FeatureRow from "../../components/work/pulse/FeatureRow.astro";
import HexBadgeGrid from "../../components/work/pulse/HexBadgeGrid.astro";
import { pulse, badges } from "../../content/pulse";

const { goalSetting, trophyCase, adminPortal } = pulse.features;
---

<BaseLayout title={`${pulse.title} — Makenna Linsky`}>
  <main class="pulse-page mx-auto max-w-5xl px-6 py-24" style="padding-top: calc(var(--nav-offset) + 6rem)">
    <header class="mx-auto max-w-3xl">
      <h1 class="font-display text-4xl uppercase">{pulse.title}</h1>
    </header>

    <div class="mx-auto max-w-3xl mt-8">
      <FilmStrip frames={pulse.meta} />
    </div>

    <FeatureRow mediaSide="right">
      <PhoneFrame slot="media" variant="flip" before={pulse.landing.before} after={pulse.landing.after} />
      {pulse.overview}
    </FeatureRow>

    <FeatureRow id={goalSetting.id} title={goalSetting.title} mediaSide="left">
      <PhoneFrame slot="media" variant="video" video={goalSetting.video} />
      {goalSetting.description}
    </FeatureRow>

    <FeatureRow id={trophyCase.id} title={trophyCase.title} stacked>
      <HexBadgeGrid slot="media" badges={badges} />
      {trophyCase.description}
    </FeatureRow>

    <FeatureRow id={adminPortal.id} title={adminPortal.title} stacked>
      <div class="admin-shots" slot="media">
        {
          adminPortal.images.map((shot) => (
            <Image
              class="admin-shots__img"
              src={shot.image}
              alt={shot.alt}
              widths={[480, 640, 960]}
              sizes="(min-width: 700px) 45vw, 90vw"
            />
          ))
        }
      </div>
      {adminPortal.description}
    </FeatureRow>

    <BackToWork class="mt-16" />
  </main>
</BaseLayout>

<style>
  /* Side by side on anything roomy enough for two ~320px+ frames; wraps to
     stacked on narrow viewports since flex-wrap wins over flex-basis there. */
  .admin-shots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
  }

  .admin-shots__img {
    display: block;
    flex: 1 1 320px;
    max-width: 100%;
    height: auto;
    border: 6px solid var(--color-ink);
    border-radius: 20px;
    background: var(--color-cream);
  }
</style>
