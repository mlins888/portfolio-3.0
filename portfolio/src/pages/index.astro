---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/hero/Hero.astro";
import WorkSection from "../components/work/WorkSection.astro";
import PlaygroundModal from "../components/playground/PlaygroundModal.astro";
import StarrySky from "../components/StarrySky.astro";
import { playground } from "../content/playground";

// The bento's tee + social tiles open these playground cards in place.
const modalIds = playground.pathways.filter((p) => p.type === "shirt" || p.type === "social").map((p) => p.id);
---

<BaseLayout>
  <!-- One starry sky behind the landing and the Work section. -->
  <div class="sky-scope">
    <StarrySky />
    <Hero />
    <WorkSection />
  </div>
  <PlaygroundModal ids={modalIds} />
</BaseLayout>

<style>
  .sky-scope {
    position: relative;
    isolation: isolate;
    /* Clears the fixed nav bar, so the sky runs right up behind it. */
    padding-top: var(--nav-offset);
  }
</style>
