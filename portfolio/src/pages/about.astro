---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { about } from "../content/about";
---

<BaseLayout title="About — Makenna Linsky">
  <main class="about-page" aria-label="About">
    <div class="about-page__band">
      <div class="about-page__copy">
        <h1 class="about-page__heading font-script text-white">{about.heading}</h1>
        <div class="about-page__body font-body text-white">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <figure class="about-page__photo">
        <Image
          src={about.photo}
          alt={about.photoAlt}
          widths={[400, 640, 960]}
          sizes="(min-width: 900px) 34vw, 80vw"
        />
      </figure>
    </div>
  </main>
</BaseLayout>

<style>
  .about-page {
    background: var(--color-paper);
    padding: clamp(0.75rem, 2.5vw, 2.5rem);
    padding-top: calc(var(--nav-offset) + clamp(0.75rem, 2.5vw, 2.5rem));
    min-height: calc(100vh - var(--nav-offset));
  }

  .about-page__band {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    background: var(--color-coral);
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.5rem, 5vw, 5rem);
    min-height: calc(100vh - var(--nav-offset) - 3rem);
  }

  @media (min-width: 900px) {
    .about-page__band {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  .about-page__heading {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 0.91;
  }

  .about-page__body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-size: clamp(1.15rem, 2.1vw, 2rem);
    line-height: 0.95;
  }

  .about-page__body p {
    margin: 0;
  }

  .about-page__photo {
    margin: 0;
    border: 12px solid var(--color-ink);
    border-radius: 110px;
    overflow: hidden;
    aspect-ratio: 496 / 580;
    background: var(--color-ink);
  }

  .about-page__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
