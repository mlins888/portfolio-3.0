---
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import ScrollRocket from "../components/ScrollRocket.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en" style={isHome ? undefined : "--nav-offset: var(--nav-h)"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- 'Archivo Black' stands in for the licensed display face 'Louvre'; see
         the font tokens in src/styles/global.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Lakki+Reddy&family=Signika+Negative:wght@300;400;600&display=swap"
    />

    <!-- Marks the document as scripted before first paint, so entrance
         animations start hidden only when GSAP can reveal them. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="bg-paper font-script text-ink antialiased">
    <Nav />
    <ScrollRocket />
    <div class="page-content">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>

<style>
  /* Sticky-footer pattern: on pages shorter than the viewport, this pushes
     the footer down to the true bottom of the screen instead of leaving
     bare page background beneath it. `min-height` (not `height`) so pages
     taller than the viewport — like the homepage — still grow normally;
     Nav/ScrollRocket are position:fixed, so they sit outside this flex
     flow entirely and aren't affected. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .page-content {
    flex: 1 0 auto;
  }
</style>
