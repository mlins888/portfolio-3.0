---
/**
 * Shared film-strip footer. Hidden until the page bottom approaches, then
 * slides/fades up. Cat idle-floats once the footer is in the document.
 */
import { footer } from "../content/footer";
import FillImage from "./FillImage.astro";
import Sparkle from "./hero/Sparkle.astro";
import { canvasStyle, css, u } from "./hero/canvas";

const sprockets = Array.from({ length: 22 }, (_, i) => i);
const [linkedIn, gitHub, email, resume] = footer.contacts;
---

<div class="site-footer-sentinel" data-footer-sentinel aria-hidden="true"></div>

<footer class="site-footer" data-site-footer aria-hidden="true">
  <div class="site-footer__film" data-footer-panel>
    <div class="site-footer__sprockets site-footer__sprockets--top" aria-hidden="true">
      {sprockets.map(() => <span class="site-footer__hole" />)}
    </div>

    <div class="site-footer__body">
      <div class="site-footer__col site-footer__col--dream">
        <div class="site-footer__dream-canvas">
          <div
            class="site-footer__cat idle-float"
            data-footer-cat
            style={canvasStyle({
              x: 18.985,
              y: 81.961,
              width: 319.807,
              height: 286.839,
              rotation: -3.3,
            })}
          >
            <FillImage
              src={footer.cat}
              alt={footer.catAlt}
              cropTop={-20.41}
              cropLeft={-41.44}
              cropWidth={165.5}
              cropHeight={128.23}
            />
          </div>

          <p
            class="site-footer__tagline font-body"
            style={css({ left: u(292), top: u(159), width: u(286), fontSize: u(36) })}
          >
            {footer.tagline}
          </p>

          <Sparkle variant="b" x={193} y={96} size={41} color="var(--color-ink)" />
          <Sparkle variant="b" x={448} y={240} size={30} color="var(--color-ink)" idleDelay={0.5} />
        </div>
      </div>

      <div class="site-footer__divider" aria-hidden="true"></div>

      <div class="site-footer__col site-footer__col--contacts">
        <div class="site-footer__contacts">
          <a class="site-footer__contact font-body" href={linkedIn.href}>{linkedIn.label}</a>
          <span class="site-footer__inline-star" aria-hidden="true">
            <Sparkle variant="a" size={28} color="var(--color-ink)" />
          </span>
          <a class="site-footer__contact font-body" href={gitHub.href}>{gitHub.label}</a>

          <a class="site-footer__contact font-body" href={email.href}>{email.label}</a>
          <span class="site-footer__inline-star" aria-hidden="true">
            <Sparkle variant="a" size={28} color="var(--color-ink)" />
          </span>
          <a class="site-footer__contact font-body" href={resume.href}>{resume.label}</a>
        </div>
      </div>

      <div class="site-footer__divider" aria-hidden="true"></div>

      <nav class="site-footer__col site-footer__col--nav" aria-label="Footer">
        <ul class="site-footer__nav">
          {
            footer.nav.map((link) => (
              <li>
                <a class="site-footer__nav-link font-body" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="site-footer__sprockets site-footer__sprockets--bottom" aria-hidden="true">
      {sprockets.map(() => <span class="site-footer__hole" />)}
    </div>
  </div>
</footer>

<style>
  .site-footer-sentinel {
    height: 1px;
    width: 100%;
    pointer-events: none;
  }

  .site-footer {
    position: relative;
    z-index: 20;
    background: var(--color-ink);
    padding-block: 0.4rem;
    transform: translateY(40%);
    opacity: 0;
    pointer-events: none;
  }

  .site-footer.is-visible {
    pointer-events: auto;
  }

  .site-footer__film {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .site-footer__sprockets {
    display: flex;
    justify-content: space-between;
    gap: 0.35rem;
    padding: 0.55rem clamp(0.75rem, 2vw, 1rem);
    background: var(--color-ink);
  }

  .site-footer__hole {
    flex: 0 0 auto;
    width: 22px;
    height: 40px;
    background: var(--color-paper);
  }

  .site-footer__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: clamp(0.5rem, 1.5vw, 0.9rem) clamp(1rem, 3vw, 2rem);
  }

  @media (min-width: 900px) {
    .site-footer__body {
      /* Nav used to be an unsized "auto" column (shrink-to-fit its own
         text), which left it far smaller than Figma's proportions. Giving it
         a real fr share — taken from the dream column — grows it properly. */
      grid-template-columns: 1.2fr auto 1fr auto 0.85fr;
      align-items: center;
      gap: 1.5rem;
    }
  }

  .site-footer__divider {
    display: none;
  }

  @media (min-width: 900px) {
    .site-footer__divider {
      display: block;
      width: 4px;
      align-self: stretch;
      background: var(--color-ink);
    }
  }

  .site-footer__col--dream {
    display: flex;
    align-items: center;
  }

  /* The cat, tagline, and its two scattered sparkles are laid out at their
     exact Figma coordinates on a local canvas (same technique as the hero),
     instead of a flex row plus percentage-guessed star offsets — which is
     what let the stars drift into overlap and kept the cat undersized. */
  .site-footer__dream-canvas {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 653 / 378;
    --u: calc(100cqw / 653);
  }

  .site-footer__tagline {
    position: absolute;
    margin: 0;
    line-height: 0.9;
  }

  .site-footer__contacts {
    display: grid;
    grid-template-columns: auto auto auto;
    column-gap: 0.85rem;
    row-gap: 1.1rem;
    align-items: center;
    justify-content: center;
  }

  .site-footer__contact {
    font-size: clamp(1.15rem, 2vw, 2.25rem);
    line-height: 0.81;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__contact:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__inline-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    /* Align sparkle with the text baseline / middle of the line */
    align-self: center;
  }

  .site-footer__inline-star :global([data-anim]) {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
  }

  .site-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .site-footer__nav-link {
    font-size: clamp(1.15rem, 2vw, 2.25rem);
    line-height: 0.81;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__nav-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from "../scripts/gsap-setup.js";

  const footer = document.querySelector("[data-site-footer]");
  const sentinel = document.querySelector("[data-footer-sentinel]");
  if (!footer || !sentinel) throw new Error("footer pieces missing");

  const reduce = prefersReducedMotion();

  // Footer sparkles shouldn't wait on a section timeline — reveal them.
  gsap.set(footer.querySelectorAll("[data-anim]"), { opacity: 1 });

  function show() {
    footer.classList.add("is-visible");
    footer.setAttribute("aria-hidden", "false");
    if (reduce) {
      gsap.set(footer, { y: 0, opacity: 1 });
      return;
    }
    gsap.to(footer, {
      y: 0,
      opacity: 1,
      duration: 0.65,
      ease: "power3.out",
      overwrite: "auto",
    });
  }

  function hide() {
    footer.classList.remove("is-visible");
    footer.setAttribute("aria-hidden", "true");
    if (reduce) {
      gsap.set(footer, { y: "40%", opacity: 0 });
      return;
    }
    gsap.to(footer, {
      y: "40%",
      opacity: 0,
      duration: 0.4,
      ease: "power2.in",
      overwrite: "auto",
    });
  }

  gsap.set(footer, { y: "40%", opacity: 0 });

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) show();
        else hide();
      });
    },
    { root: null, threshold: 0, rootMargin: "0px 0px 0px 0px" },
  );

  io.observe(sentinel);
</script>
