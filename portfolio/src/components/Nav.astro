---
/**
 * Site header that starts hidden on the homepage and arrives as a shrunk
 * version of the hero masthead — coral bar, display-font name, nav links.
 * On other pages there's no hero to shrink from, so it shows immediately.
 */
import { site } from "../content/site";
import { hero } from "../content/hero";

const path = Astro.url.pathname;
const isHome = path === "/";
const brand = hero.nameLines.join(" ");

function isCurrent(href: string) {
  if (href.startsWith("/#")) return false;
  return href === "/" ? path === "/" : path.startsWith(href);
}
---

<header
  class:list={["site-header", !isHome && "is-solid"]}
  data-site-header
  data-home={isHome ? "true" : "false"}
>
  <div class="site-header__bar">
    <a href="/" class="site-header__brand font-display uppercase text-cream">
      {brand}
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul class="site-header__links">
        {
          site.nav.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-header__link"
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --header-progress: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
    transform: translateY(calc((1 - var(--header-progress)) * -100%));
  }

  .site-header.is-solid {
    --header-progress: 1;
    pointer-events: auto;
  }

  .site-header.is-active {
    pointer-events: auto;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--nav-h);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    background: var(--color-coral);
    box-shadow: 0 2px 0 var(--color-ink);
  }

  .site-header__brand {
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-shadow: 2px 2px 0 var(--color-ink);
    white-space: nowrap;
    text-decoration: none;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__link {
    font-family: var(--font-script);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    color: var(--color-cream);
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }

  .site-header__link:hover,
  .site-header__link[aria-current="page"] {
    color: var(--color-ink);
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from "../scripts/gsap-setup.js";

  const header = document.querySelector("[data-site-header]");
  if (!header) throw new Error("site header missing");

  const isHome = header.getAttribute("data-home") === "true";
  const root = document.documentElement;

  function setProgress(progress) {
    const p = Math.min(1, Math.max(0, progress));
    header.style.setProperty("--header-progress", String(p));
    const active = p > 0.05;
    header.classList.toggle("is-active", active);
    header.toggleAttribute("inert", !active);
    header.setAttribute("aria-hidden", active ? "false" : "true");
    root.style.setProperty("--nav-offset", `calc(${p} * var(--nav-h))`);
  }

  if (!isHome) {
    setProgress(1);
  } else {
    const hero = document.querySelector("[data-hero]");
    const name = hero?.querySelector(".hero-name");
    const extras = [
      hero?.querySelector('[data-anim="greeting"]'),
      hero?.querySelector('[data-anim="burst"]'),
      hero?.querySelector("[data-stamp]"),
      hero?.querySelector("[data-logo]"),
    ].filter(Boolean);

    if (!hero) {
      setProgress(1);
    } else if (prefersReducedMotion()) {
      const sync = () => {
        const rect = hero.getBoundingClientRect();
        setProgress(rect.bottom < window.innerHeight * 0.4 ? 1 : 0);
      };
      sync();
      window.addEventListener("scroll", sync, { passive: true });
    } else {
      setProgress(0);

      ScrollTrigger.create({
        trigger: hero,
        start: "top top",
        end: "center top",
        scrub: 0.4,
        onUpdate: (self) => setProgress(self.progress),
      });

      if (name) {
        gsap.fromTo(
          name,
          { scale: 1, yPercent: 0, opacity: 1 },
          {
            scale: 0.2,
            yPercent: -35,
            opacity: 0,
            transformOrigin: "50% 0%",
            ease: "none",
            scrollTrigger: {
              trigger: hero,
              start: "top top",
              end: "center top",
              scrub: 0.4,
            },
          },
        );
      }

      if (extras.length) {
        gsap.to(extras, {
          opacity: 0,
          y: -24,
          ease: "none",
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "30% top",
            scrub: true,
          },
        });
      }

      ScrollTrigger.refresh();
    }
  }
</script>
