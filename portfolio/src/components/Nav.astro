---
/**
 * Site header that starts hidden on the homepage and arrives as the hero
 * masthead collapses. On home, the display name is a single Flip-shared
 * instance that moves from the hero into this brand slot.
 */
import { site } from "../content/site";
import { hero } from "../content/hero";

const path = Astro.url.pathname;
const isHome = path === "/";
const brand = hero.nameLines.join(" ");

function isCurrent(href: string) {
  if (href.startsWith("/#")) return false;
  return href === "/" ? path === "/" : path.startsWith(href);
}
---

<header
  class:list={["site-header", !isHome && "is-solid"]}
  data-site-header
  data-home={isHome ? "true" : "false"}
>
  <div class="site-header__bar">
    <div class="site-header__brand-slot" data-brand-nav>
      {
        !isHome && (
          <a href="/" class="site-header__brand font-display uppercase text-cream" data-site-brand>
            {brand}
          </a>
        )
      }
    </div>

    <nav class="site-header__nav" aria-label="Main">
      <ul class="site-header__links">
        {
          site.nav.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-header__link"
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --header-progress: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
    transform: translateY(calc((1 - var(--header-progress)) * -100%));
  }

  .site-header.is-solid {
    --header-progress: 1;
    pointer-events: auto;
  }

  .site-header.is-active {
    pointer-events: auto;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--nav-h);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    background: var(--color-coral);
    box-shadow: 0 2px 0 var(--color-ink);
  }

  .site-header__brand-slot {
    display: flex;
    align-items: center;
    min-height: 1.2em;
    min-width: 8rem;
  }

  .site-header__brand,
  .site-header__brand-slot :global([data-site-brand]) {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-cream);
    text-shadow: 2px 2px 0 var(--color-ink);
    white-space: nowrap;
    text-decoration: none;
    text-transform: uppercase;
    margin: 0;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__link {
    font-family: var(--font-script);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    color: var(--color-cream);
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }

  .site-header__link:hover,
  .site-header__link[aria-current="page"] {
    color: var(--color-ink);
  }
</style>

<script>
  import { gsap, ScrollTrigger, Flip, prefersReducedMotion } from "../scripts/gsap-setup.js";

  const header = document.querySelector("[data-site-header]");
  if (!header) throw new Error("site header missing");

  const isHome = header.getAttribute("data-home") === "true";
  const root = document.documentElement;
  const navSlot = header.querySelector("[data-brand-nav]");
  // HeroNavBadge is the real nav pre-scroll — its opacity is scrubbed along
  // with the rest of the hero's "extras" below, but that tween alone would
  // leave its links invisibly clickable/tabbable once faded. Tying `inert`
  // to the exact same threshold that activates the real header bar keeps
  // exactly one nav interactive at a time.
  const heroNavBadge = document.querySelector("[data-hero-nav-badge]");

  function setProgress(progress) {
    const p = Math.min(1, Math.max(0, progress));
    header.style.setProperty("--header-progress", String(p));
    const active = p > 0.05;
    header.classList.toggle("is-active", active);
    header.toggleAttribute("inert", !active);
    header.setAttribute("aria-hidden", active ? "false" : "true");
    heroNavBadge?.toggleAttribute("inert", active);
    root.style.setProperty("--nav-offset", `calc(${p} * var(--nav-h))`);
  }

  if (!isHome) {
    setProgress(1);
  } else {
    const hero = document.querySelector("[data-hero]");
    const homeSlot = hero?.querySelector("[data-brand-home]");
    const brand = document.querySelector("[data-site-brand]");
    const extras = [
      hero?.querySelector('[data-anim="greeting"]'),
      hero?.querySelector('[data-anim="burst"]'),
      hero?.querySelector("[data-stamp]"),
      hero?.querySelector("[data-logo]"),
      hero?.querySelector("[data-hero-nav-badge]"),
    ].filter(Boolean);

    // Hero.astro writes the headline's canvas position/size as an INLINE
    // style (fontSize/lineHeight/width in canvas units). That inline style
    // beats any class-based CSS rule — including `.is-in-nav` — so without
    // clearing it here the name renders at its full ~130px hero size no
    // matter what class is on it, once it's sitting in the compact nav slot.
    function moveBrandToNav() {
      if (brand.dataset.heroStyle === undefined) {
        brand.dataset.heroStyle = brand.getAttribute("style") || "";
      }
      brand.removeAttribute("style");
      brand.classList.add("is-in-nav");
      navSlot.appendChild(brand);
    }

    function moveBrandToHero() {
      brand.classList.remove("is-in-nav");
      if (brand.dataset.heroStyle) {
        brand.setAttribute("style", brand.dataset.heroStyle);
      }
      homeSlot.appendChild(brand);
    }

    if (!hero || !homeSlot || !navSlot || !brand) {
      setProgress(1);
    } else if (prefersReducedMotion()) {
      const sync = () => {
        const rect = hero.getBoundingClientRect();
        const collapsed = rect.bottom < window.innerHeight * 0.4;
        setProgress(collapsed ? 1 : 0);
        if (collapsed && brand.parentElement !== navSlot) {
          moveBrandToNav();
        } else if (!collapsed && brand.parentElement !== homeSlot) {
          moveBrandToHero();
        }
      };
      sync();
      window.addEventListener("scroll", sync, { passive: true });
    } else {
      setProgress(0);

      // Driven by a single desired state ("hero" | "nav") instead of one-shot
      // onEnter/onLeaveBack callbacks: a quick scroll direction change during
      // the 0.7s Flip animation used to get silently dropped (the `flipping`
      // guard just returned early), permanently stranding the name in the
      // wrong slot. Now a change mid-flight is queued and applied as soon as
      // the current Flip finishes, so no scroll direction is ever lost.
      let inNav = false;
      let flipping = false;
      let pendingState = null;

      function applyState(target) {
        if (flipping) {
          pendingState = target;
          return;
        }
        if ((target === "nav") === inNav) return;

        flipping = true;
        const state = Flip.getState(brand);
        if (target === "nav") {
          moveBrandToNav();
        } else {
          moveBrandToHero();
        }
        Flip.from(state, {
          duration: 0.7,
          ease: "power2.inOut",
          absolute: true,
          scale: true,
          onComplete: () => {
            inNav = target === "nav";
            flipping = false;
            if (pendingState !== null) {
              const next = pendingState;
              pendingState = null;
              applyState(next);
            }
          },
        });
      }

      ScrollTrigger.create({
        trigger: hero,
        start: "top top",
        end: "center top",
        scrub: 0.4,
        onUpdate: (self) => setProgress(self.progress),
      });

      ScrollTrigger.create({
        trigger: hero,
        start: "55% top",
        end: "center top",
        onEnter: () => applyState("nav"),
        onLeaveBack: () => applyState("hero"),
      });

      if (extras.length) {
        gsap.fromTo(
          extras,
          { opacity: 1, y: 0 },
          {
            opacity: 0,
            y: -24,
            ease: "none",
            scrollTrigger: {
              trigger: hero,
              start: "top top",
              end: "30% top",
              scrub: true,
            },
          },
        );
      }

      ScrollTrigger.refresh();
    }
  }
</script>
