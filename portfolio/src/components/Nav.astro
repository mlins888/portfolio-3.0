---
/**
 * Site nav — a stub that establishes the routing shape. Work is an anchor on
 * the homepage rather than its own route. Links come from src/content/site.ts.
 */
import { site } from "../content/site";

const path = Astro.url.pathname;

function isCurrent(href: string) {
  if (href.startsWith("/#")) return false;
  return href === "/" ? path === "/" : path.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-paper/95 backdrop-blur-sm">
  <nav
    class="mx-auto flex h-[var(--nav-h)] max-w-7xl items-center justify-between gap-6 px-6"
    aria-label="Main"
  >
    <a href="/" class="font-script text-lg text-ink"> Makenna Linsky </a>

    <ul class="flex items-center gap-6 font-script text-base">
      {
        site.nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink underline-offset-4 transition-colors hover:text-coral hover:underline aria-[current=page]:text-coral"
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
