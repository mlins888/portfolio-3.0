---
/**
 * Site header, always on screen: one slim paper bar with the name on the
 * left, the page links spread evenly across the middle, and contact icons
 * on the right. The name and links are checkpoints (`data-checkpoint`) for
 * the rocket riding the bar's bottom edge, which prints a halftone trail
 * into the bar as it flies (NavRocket.astro).
 */
import { site } from "../content/site";
import { hero } from "../content/hero";
import { footer } from "../content/footer";
import NavRocket from "./NavRocket.astro";
import navCat from "../assets/illustrations/nav-cat.png";

const path = Astro.url.pathname;
const isHome = path === "/";
const brand = hero.nameLines.join(" ");

// The name already links home, so the bar skips the "Home" entry (the
// hero's comic-cover nav still shows it).
const links = site.nav.filter((link) => link.href !== "/");

// Contact icons, in the order a recruiter is likeliest to want them.
const ICON_ORDER = ["resume", "github", "linkedin", "email"] as const;
const contacts = ICON_ORDER.map((id) => footer.contacts.find((c) => c.icon === id)!).filter(Boolean);

/** Which checkpoint the rocket parks at on this page ("" = the homepage,
 *  where scrolling moves it between Home and Work instead). */
const currentCheckpoint = isHome
  ? ""
  : path.startsWith("/work")
    ? "work"
    : (links.find((link) => !link.href.startsWith("/#") && path.startsWith(link.href))?.label.toLowerCase() ?? "home");

function isCurrent(href: string) {
  if (href.startsWith("/#")) return false;
  return href === "/" ? path === "/" : path.startsWith(href);
}
---

<header
  class="site-header"
  data-site-header
  data-home={isHome ? "true" : "false"}
  data-current-checkpoint={currentCheckpoint}
>
  <div class="site-header__bar">
    <a class="site-header__brand-slot" href="/" aria-label={`${brand}, home`} data-checkpoint="home">
      <img class="site-header__brand" src={navCat.src} alt="" width={navCat.width} height={navCat.height} />
    </a>

    <div class="site-header__right">
      <nav class="site-header__nav" aria-label="Main">
        <ul class="site-header__links">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-header__link font-body"
                  data-checkpoint={link.label.toLowerCase()}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  {"short" in link && link.short ? (
                    <>
                      <span class="site-header__label--long">{link.label}</span>
                      <span class="site-header__label--short">{link.short}</span>
                    </>
                  ) : (
                    link.label
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="site-header__icons" aria-label="Contact">
        {
          contacts.map((contact) => (
            <li>
              <a
                class="site-header__icon"
                href={contact.href}
                aria-label={contact.label}
                title={contact.label}
                {...(contact.icon === "resume" || contact.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener" }
                  : {})}
              >
                {contact.icon === "resume" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6M8 13h8M8 17h5" />
                  </svg>
                )}
                {contact.icon === "github" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                    <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
                  </svg>
                )}
                {contact.icon === "linkedin" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z" />
                  </svg>
                )}
                {contact.icon === "email" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
                    <path d="m3 6 9 7 9-7" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <NavRocket />
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--nav-h);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    background: var(--color-paper);
    border-bottom: 3px solid var(--color-ink);
  }

  /* Above NavRocket's trail canvas, which fills the bar behind them. */
  .site-header__brand-slot,
  .site-header__right {
    position: relative;
    z-index: 1;
  }

  .site-header__brand-slot {
    display: flex;
    align-items: center;
    flex: none;
    min-height: 1.2em;
    color: inherit;
    text-decoration: none;
  }

  /* The cat mascot (the tab icon's cat, line art only) as the home link. */
  .site-header__brand {
    display: block;
    width: auto;
    height: 32px;
    transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .site-header__brand-slot:hover .site-header__brand,
  .site-header__brand-slot:focus-visible .site-header__brand {
    transform: rotate(-6deg) scale(1.06);
  }

  /* Takes all the room between the name and the edge, so the links can
     spread out and give the rocket long runs between checkpoints. */
  .site-header__right {
    flex: 1;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .site-header__nav {
    flex: 1;
  }

  .site-header__links,
  .site-header__icons {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links {
    justify-content: space-evenly;
    gap: 0.75rem;
    width: 100%;
  }

  /* Boxes hug the words exactly: NavRocket fades its trail dots out
     around these boxes (and the cat's), so they sit in a clearing in the
     halftone. */
  .site-header__link {
    display: inline-block;
  }

  .site-header__link {
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
    transition: text-decoration-color 160ms ease;
  }

  .site-header__link:hover,
  .site-header__link:focus-visible,
  .site-header__link[aria-current="page"] {
    text-decoration-color: var(--color-coral);
  }

  .site-header__label--short {
    display: none;
  }

  /* Divider between the page links and the contact icons. */
  .site-header__icons {
    gap: 0.35rem;
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: 2px solid var(--color-ink);
  }

  .site-header__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-ink);
    border-radius: 999px;
    transition:
      color 160ms ease,
      transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .site-header__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-header__icon:hover,
  .site-header__icon:focus-visible {
    color: var(--color-coral);
    transform: translateY(-2px);
  }

  .site-header :is(.site-header__link, .site-header__icon, .site-header__brand-slot):focus-visible {
    outline: 3px solid var(--color-teal-deep);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Phones: the contact icons live in the footer, and "Playground" gets
     its short label, so the bar fits a 390px screen. */
  @media (max-width: 699px) {
    .site-header__bar {
      gap: 0.75rem;
    }

    .site-header__icons {
      display: none;
    }

    .site-header__label--long {
      display: none;
    }

    .site-header__label--short {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__icon {
      transition: color 160ms ease;
    }

    .site-header__brand {
      transition: none;
    }

    .site-header__brand-slot:hover .site-header__brand,
    .site-header__brand-slot:focus-visible .site-header__brand {
      transform: none;
    }

    .site-header__icon:hover,
    .site-header__icon:focus-visible {
      transform: none;
    }
  }
</style>

