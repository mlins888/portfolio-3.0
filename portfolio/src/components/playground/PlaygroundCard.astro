---
/**
 * One card's worth of content, rendered for every pathway in
 * src/content/playground.ts and toggled visible by PlaygroundModal's script.
 * The `type` switch is the only branch here — everything else (title, copy,
 * media) comes straight from the config, so a new game/board-game/shirt
 * entry never needs a markup change. `shirt` shows 1–2 real design views
 * (front, or front + back), `boardgame` shows the card carousel + map in
 * BoardGameCard.astro, and `game` / `social` have no finished art yet so
 * they render the shared <WipStub> ("still workin on this one...") — swap
 * those back to real media once the designs exist.
 */
import { Image } from "astro:assets";
import type { PlaygroundPathway } from "../../content/playground";
import BoardGameCard from "./BoardGameCard.astro";
import WipStub from "../WipStub.astro";

interface Props {
  pathway: PlaygroundPathway;
}

const { pathway } = Astro.props;

const EYEBROW: Record<PlaygroundPathway["type"], string> = {
  game: "Video game",
  boardgame: "Board game",
  shirt: "Tee design",
  social: "Social media",
};
---

<div class="playground-card" data-modal-panel={pathway.id} hidden>
  <p class="playground-card__eyebrow font-script text-coral">{EYEBROW[pathway.type]}</p>
  <h2 class="playground-card__title font-body font-semibold" id={`playground-card-title-${pathway.id}`}>
    {pathway.title}
  </h2>
  <p class="playground-card__desc font-body font-light">{pathway.description}</p>

  {
    pathway.type === "social" ? (
      <WipStub />
    ) : pathway.type === "shirt" ? (
      <div class="playground-card__designs" data-count={pathway.designs.length}>
        {pathway.designs.map((view) => (
          <figure class="playground-card__design">
            <Image
              src={view.image}
              alt={view.alt}
              widths={pathway.designs.length === 2 ? [320, 480, 768] : [480, 768, 1088]}
              sizes={
                pathway.designs.length === 2
                  ? "(min-width: 640px) 20rem, 45vw"
                  : "(min-width: 640px) 34rem, 90vw"
              }
            />
            {view.label && <figcaption class="playground-card__design-label font-script">{view.label}</figcaption>}
          </figure>
        ))}
      </div>
    ) : pathway.type === "boardgame" ? (
      <BoardGameCard />
    ) : (
      <WipStub />
    )
  }

  {
    "tags" in pathway && pathway.tags && pathway.tags.length > 0 && (
      <div class="playground-card__tags">
        {pathway.tags.map((tag) => (
          <span class="playground-card__tag font-script">{tag}</span>
        ))}
      </div>
    )
  }
</div>

<style>
  .playground-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .playground-card__eyebrow {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1;
    margin: 0;
  }

  .playground-card__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
    margin: 0;
    color: var(--color-ink);
  }

  .playground-card__desc {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.4;
    margin: 0;
    color: var(--color-ink);
    opacity: 0.85;
  }

  .playground-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 16rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
    border: 6px solid var(--color-ink);
    border-radius: 24px;
    background: var(--color-cream);
    color: var(--color-teal);
  }

  .playground-card__media :global(svg) {
    max-width: 60%;
    max-height: 60%;
  }

  .playground-card__designs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .playground-card__design {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    /* Shrink to the image — the frame should hug the art, not the column. */
    flex: 0 1 auto;
  }

  /* Front + back: cap each so the pair fits side by side. */
  .playground-card__designs[data-count="2"] .playground-card__design {
    max-width: calc(50% - 0.375rem);
  }

  .playground-card__design :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(68vh, 30rem);
    border: 6px solid var(--color-ink);
    border-radius: 18px;
    background: var(--color-cream);
  }

  .playground-card__designs[data-count="2"] .playground-card__design :global(img) {
    max-height: min(55vh, 22rem);
  }

  .playground-card__design-label {
    margin: 0;
    text-align: center;
    font-size: 1rem;
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.7;
  }

  .playground-card__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .playground-card__grid-item {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border: 4px solid var(--color-ink);
    border-radius: 14px;
    background: var(--color-cream);
    color: var(--color-teal);
  }

  .playground-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .playground-card__tag {
    font-size: 1rem;
    line-height: 1;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--color-teal);
    color: white;
  }
</style>
