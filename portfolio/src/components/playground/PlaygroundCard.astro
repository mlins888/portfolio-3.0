---
/**
 * One card's worth of content, rendered for every pathway in
 * src/content/playground.ts and toggled visible by PlaygroundModal's script.
 * The `type` switch is the only branch here — everything else (title, copy,
 * media) comes straight from the config, so a new game/board-game/shirt
 * entry never needs a markup change. `social` swaps the single-image layout
 * for a grid, `shirt` swaps it for 1–2 real design views (front, or front +
 * back), and `boardgame` swaps it for the card carousel + map in
 * BoardGameCard.astro — variants of this same component, not separate ones.
 */
import { Image } from "astro:assets";
import type { PlaygroundPathway } from "../../content/playground";
import BoardGameCard from "./BoardGameCard.astro";

interface Props {
  pathway: PlaygroundPathway;
}

const { pathway } = Astro.props;

const EYEBROW: Record<PlaygroundPathway["type"], string> = {
  game: "Video game",
  boardgame: "Board game",
  shirt: "Tee design",
  social: "Social media",
};
---

<div class="playground-card" data-modal-panel={pathway.id} hidden>
  <p class="playground-card__eyebrow font-script text-coral">{EYEBROW[pathway.type]}</p>
  <h2 class="playground-card__title font-body font-semibold" id={`playground-card-title-${pathway.id}`}>
    {pathway.title}
  </h2>
  <p class="playground-card__desc font-body font-light">{pathway.description}</p>

  {
    pathway.type === "social" ? (
      <div class="playground-card__grid">
        {pathway.images.map((img) => (
          <div class="playground-card__grid-item" style={img.tint ? `color:${img.tint}` : undefined}>
            <img.image class="block h-full w-full" />
          </div>
        ))}
      </div>
    ) : pathway.type === "shirt" ? (
      <div class="playground-card__designs" data-count={pathway.designs.length}>
        {pathway.designs.map((view) => (
          <figure class="playground-card__design">
            <Image src={view.image} alt={view.alt} widths={[320, 480, 640]} sizes="(min-width: 900px) 16rem, 45vw" />
            {view.label && <figcaption class="playground-card__design-label font-script">{view.label}</figcaption>}
          </figure>
        ))}
      </div>
    ) : pathway.type === "boardgame" ? (
      <BoardGameCard />
    ) : (
      <div class="playground-card__media">
        <pathway.image class="block h-full w-full" />
      </div>
    )
  }

  {
    "tags" in pathway && pathway.tags && pathway.tags.length > 0 && (
      <div class="playground-card__tags">
        {pathway.tags.map((tag) => (
          <span class="playground-card__tag font-script">{tag}</span>
        ))}
      </div>
    )
  }
</div>

<style>
  .playground-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .playground-card__eyebrow {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1;
    margin: 0;
  }

  .playground-card__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
    margin: 0;
    color: var(--color-ink);
  }

  .playground-card__desc {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.4;
    margin: 0;
    color: var(--color-ink);
    opacity: 0.85;
  }

  .playground-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 16rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
    border: 6px solid var(--color-ink);
    border-radius: 24px;
    background: var(--color-cream);
    color: var(--color-teal);
  }

  .playground-card__media :global(svg) {
    max-width: 60%;
    max-height: 60%;
  }

  .playground-card__designs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  /* Front + back: two views side by side instead of one full-width. */
  .playground-card__designs[data-count="2"] {
    grid-template-columns: 1fr 1fr;
  }

  .playground-card__design {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .playground-card__design :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 20rem;
    object-fit: contain;
    border: 6px solid var(--color-ink);
    border-radius: 18px;
    background: var(--color-cream);
  }

  .playground-card__design-label {
    margin: 0;
    text-align: center;
    font-size: 1rem;
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.7;
  }

  .playground-card__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .playground-card__grid-item {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border: 4px solid var(--color-ink);
    border-radius: 14px;
    background: var(--color-cream);
    color: var(--color-teal);
  }

  .playground-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .playground-card__tag {
    font-size: 1rem;
    line-height: 1;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--color-teal);
    color: white;
  }
</style>
