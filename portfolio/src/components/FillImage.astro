---
/**
 * Reproduces a Figma "image fill" crop. Several exported assets (the hero
 * buildings, the corner cat, the two pill textures) all reference the same
 * oversized master artwork canvas — the visible slice is described by an
 * oversized width/height with a negative top/left offset, all as percentages
 * of the container. Percentages keep the crop's effective zoom constant
 * regardless of the container's actual rendered size, so this is safe to
 * reuse on auto-width elements like pills.
 *
 * The wrapping element must supply its own size (via canvasStyle, CSS, or a
 * parent that clips to shape) — this component only fills it.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  cropTop: number;
  cropLeft: number;
  cropWidth: number;
  cropHeight: number;
  class?: string;
}

const { src, alt, cropTop, cropLeft, cropWidth, cropHeight, class: className } = Astro.props;
---

<div class:list={["relative block h-full w-full overflow-hidden", className]}>
  <Image
    src={src}
    alt={alt}
    class="absolute max-w-none"
    style={`top:${cropTop}%; left:${cropLeft}%; width:${cropWidth}%; height:${cropHeight}%;`}
  />
</div>
