---
/**
 * Halftone cursor trail.
 *
 * A fixed, click-through canvas paints a halftone dot screen behind the
 * cursor: dots are big and packed together right at the pointer and shrink
 * to nothing toward the tail, so the trail reads denser near the mouse and
 * sparser further away. The dots sit on a fixed, offset-row grid (like a
 * printed halftone screen) — only their size changes, never their position.
 *
 * Mouse/trackpad only (pointer: fine), and skipped for reduced motion.
 */
---

<canvas class="cursor-trail" aria-hidden="true"></canvas>

<style>
  .cursor-trail {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    /* Above the nav and modals, below MobileGate (which phones see anyway). */
    z-index: 999;
  }
</style>

<script>
  import { prefersReducedMotion } from "../scripts/gsap-setup.js";

  // Grid pitch of the halftone screen, in CSS px.
  const SPACING = 9;
  // Largest dot radius — just under half the pitch so neighbours never merge.
  const MAX_DOT = SPACING * 0.48;
  // How far each trail point's influence reaches at full strength.
  const REACH = 42;
  // How long a trail point lives, in ms. Longer = longer tail.
  const LIFE = 850;
  // Fast moves are filled in with a point every STEP px so the tail stays continuous.
  const STEP = 6;
  // Ignore anything fainter than this so the tail ends cleanly.
  const CUTOFF = 0.06;
  // Where the trail starts relative to the pointer hotspot (the arrow's tip):
  // the base of the arrow's tail in public/cursor.svg.
  const ORIGIN_X = 20;
  const ORIGIN_Y = 18;

  const canvas = document.querySelector<HTMLCanvasElement>(".cursor-trail");
  const fine = window.matchMedia("(pointer: fine)").matches;

  if (canvas && fine && !prefersReducedMotion()) {
    const ctx = canvas.getContext("2d")!;
    const ink = getComputedStyle(document.documentElement).getPropertyValue("--color-ink").trim() || "#010101";

    let cols = 0;
    let rows = 0;
    let field = new Float32Array(0);
    const trail: { x: number; y: number; t: number }[] = [];
    let last: { x: number; y: number } | null = null;
    let running = false;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(window.innerWidth * dpr);
      canvas!.height = Math.round(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(window.innerWidth / SPACING) + 2;
      rows = Math.ceil(window.innerHeight / SPACING) + 2;
      field = new Float32Array(cols * rows);
    }

    function addPoint(x: number, y: number, t: number) {
      if (last) {
        const dx = x - last.x;
        const dy = y - last.y;
        const n = Math.floor(Math.hypot(dx, dy) / STEP);
        for (let i = 1; i < n; i++) {
          trail.push({ x: last.x + (dx * i) / n, y: last.y + (dy * i) / n, t });
        }
      }
      trail.push({ x, y, t });
      last = { x, y };
      if (!running) {
        running = true;
        requestAnimationFrame(frame);
      }
    }

    function frame(now: number) {
      // Drop expired points (they're pushed in time order).
      while (trail.length && now - trail[0].t > LIFE) trail.shift();

      field.fill(0);
      for (const p of trail) {
        const life = 1 - (now - p.t) / LIFE;
        if (life <= 0) continue;
        // Older points are both weaker and narrower, so the tail tapers.
        const strength = life * life;
        const reach = REACH * (0.35 + 0.65 * life);
        const r0 = Math.max(0, Math.floor((p.y - reach) / SPACING));
        const r1 = Math.min(rows - 1, Math.ceil((p.y + reach) / SPACING));
        for (let r = r0; r <= r1; r++) {
          const off = r % 2 ? SPACING / 2 : 0;
          const cy = r * SPACING;
          const c0 = Math.max(0, Math.floor((p.x - reach - off) / SPACING));
          const c1 = Math.min(cols - 1, Math.ceil((p.x + reach - off) / SPACING));
          for (let c = c0; c <= c1; c++) {
            const d = Math.hypot(c * SPACING + off - p.x, cy - p.y);
            if (d >= reach) continue;
            const falloff = 1 - d / reach;
            const v = strength * falloff * falloff;
            const i = r * cols + c;
            if (v > field[i]) field[i] = v;
          }
        }
      }

      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      ctx.fillStyle = ink;
      ctx.beginPath();
      for (let r = 0; r < rows; r++) {
        const off = r % 2 ? SPACING / 2 : 0;
        for (let c = 0; c < cols; c++) {
          const v = field[r * cols + c];
          if (v < CUTOFF) continue;
          // Dot area tracks intensity, like real halftone ink coverage.
          const radius = MAX_DOT * Math.sqrt(v);
          const x = c * SPACING + off;
          const y = r * SPACING;
          ctx.moveTo(x + radius, y);
          ctx.arc(x, y, radius, 0, Math.PI * 2);
        }
      }
      ctx.fill();

      if (trail.length) {
        requestAnimationFrame(frame);
      } else {
        running = false;
        last = null;
      }
    }

    resize();
    window.addEventListener("resize", resize);
    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        addPoint(e.clientX + ORIGIN_X, e.clientY + ORIGIN_Y, performance.now());
      },
      { passive: true },
    );
    // Don't draw a streak from where the pointer left to where it re-enters.
    document.documentElement.addEventListener("pointerleave", () => (last = null));
  }
</script>
