---
/**
 * "Now playing" / "Last played" widget for the About page.
 *
 * Renders nothing on the server. On mount it fetches /api/now-playing.json
 * (a Vercel serverless function that talks to Spotify) and fills itself in.
 * If the fetch fails or there's no track, the widget stays hidden — the page
 * reads fine without it.
 */
---

<a
  class="now-playing"
  hidden
  data-now-playing
  href="#"
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="now-playing__art" aria-hidden="true">
    <img alt="" data-np-art />
    <span class="now-playing__equalizer" data-np-eq>
      <i></i><i></i><i></i>
    </span>
  </span>

  <span class="now-playing__text">
    <span class="now-playing__label font-body" data-np-label>Last played</span>
    <span class="now-playing__title font-body" data-np-title></span>
    <span class="now-playing__artist font-body" data-np-artist></span>
  </span>
</a>

<script>
  interface Track {
    isPlaying: boolean;
    title: string;
    artist: string;
    album: string;
    albumImageUrl: string | null;
    songUrl: string;
    playedAt?: string;
  }

  const root = document.querySelector<HTMLAnchorElement>("[data-now-playing]");
  if (root) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;

    fetch("/api/now-playing.json", { headers: { Accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data: { track: Track | null }) => {
        const t = data.track;
        if (!t) return;

        root.href = t.songUrl;
        q<HTMLElement>("[data-np-label]").textContent = t.isPlaying
          ? "Now playing"
          : "Last played";
        q<HTMLElement>("[data-np-title]").textContent = t.title;
        q<HTMLElement>("[data-np-artist]").textContent = t.artist;

        const art = q<HTMLImageElement>("[data-np-art]");
        if (t.albumImageUrl) {
          art.src = t.albumImageUrl;
          art.alt = `${t.album} album art`;
        } else {
          art.remove();
        }

        root.classList.toggle("is-playing", t.isPlaying);
        root.hidden = false;
      })
      .catch(() => {
        /* leave the widget hidden */
      });
  }
</script>

<style>
  .now-playing {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2rem;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-ink);
    text-decoration: none;
    max-width: 100%;
    transition: transform 0.15s ease;
  }

  .now-playing:hover {
    transform: translateY(-2px);
  }

  .now-playing__art {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-ink);
  }

  .now-playing__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Animated bars — only shown while a track is actually playing. */
  .now-playing__equalizer {
    position: absolute;
    inset: 0;
    display: none;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    padding-bottom: 8px;
    background: rgba(1, 1, 1, 0.45);
  }

  .now-playing.is-playing .now-playing__equalizer {
    display: flex;
  }

  .now-playing__equalizer i {
    width: 3px;
    height: 6px;
    background: var(--color-cream);
    animation: np-bounce 0.9s ease-in-out infinite;
  }

  .now-playing__equalizer i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .now-playing__equalizer i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes np-bounce {
    0%,
    100% {
      height: 5px;
    }
    50% {
      height: 18px;
    }
  }

  .now-playing__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .now-playing__label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-coral);
  }

  .now-playing__title {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .now-playing__artist {
    font-size: 0.8rem;
    opacity: 0.75;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .now-playing,
    .now-playing__equalizer i {
      transition: none;
      animation: none;
    }
  }
</style>
