---
/**
 * The vintage postmark block — two cream plates carrying a date and a price.
 * Child coordinates are local to the badge, so moving it only means changing
 * x / y.
 */
import { canvasStyle, css, u, type CanvasBox } from "./canvas";

interface Props extends CanvasBox {
  date: string;
  price: string;
  class?: string;
}

const { date, price, class: className, ...box } = Astro.props;

const PLATE_WIDTH = 126;
const TYPE_SIZE = 32;

const plates = [
  { label: date, y: 0, height: 58 },
  { label: price, y: 69, height: 42 },
];
---

<div class:list={[className]} style={canvasStyle(box)}>
  {
    plates.map((plate) => (
      <div
        class="absolute flex items-center justify-center bg-cream text-ink"
        style={css({
          left: u(0),
          top: u(plate.y),
          width: u(PLATE_WIDTH),
          height: u(plate.height),
        })}
      >
        <span class="font-script leading-none" style={css({ fontSize: u(TYPE_SIZE) })}>
          {plate.label}
        </span>
      </div>
    ))
  }
</div>
