---
/**
 * The vintage postmark block — two cream plates carrying a date and a price.
 * Date is filled client-side from the current day (e.g. AUG 10); `date` prop is
 * only a no-JS fallback.
 */
import { canvasStyle, css, u, type CanvasBox } from "./canvas";

interface Props extends CanvasBox {
  date: string;
  price: string;
  class?: string;
}

const { date, price, class: className, ...box } = Astro.props;

const PLATE_WIDTH = 126;
const TYPE_SIZE = 32;

const plates = [
  { key: "date", label: date, y: 0, height: 58 },
  { key: "price", label: price, y: 69, height: 42 },
];
---

<div class:list={[className]} style={canvasStyle(box)} data-stamp>
  {
    plates.map((plate) => (
      <div
        class="absolute flex items-center justify-center bg-cream text-ink"
        style={css({
          left: u(0),
          top: u(plate.y),
          width: u(PLATE_WIDTH),
          height: u(plate.height),
        })}
      >
        <span
          class="font-script leading-none"
          style={css({ fontSize: u(TYPE_SIZE) })}
          data-stamp-label={plate.key}
        >
          {plate.label}
        </span>
      </div>
    ))
  }
</div>

<script>
  const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
  const now = new Date();
  const live = `${MONTHS[now.getMonth()]} ${String(now.getDate()).padStart(2, "0")}`;

  document.querySelectorAll('[data-stamp-label="date"]').forEach((el) => {
    el.textContent = live;
  });
</script>
