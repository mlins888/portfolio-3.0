---
/**
 * The landing: a white planet in a night sky, with the buildings rising from
 * it and the character swinging from a tree. Everything sits on a 1440 × 963
 * canvas that mirrors the Figma frame ("Wireframe - landing"), so the x / y /
 * size numbers below are the ones in Figma's inspector (see ./canvas.ts).
 * Later siblings paint on top. The stars behind it all are a separate
 * parallax layer (StarrySky.astro) that the page wraps around this.
 *
 * Building hotspots smooth-scroll to Work anchors; SpeechBubble only mounts
 * while a building is hovered. The top half is the Rive cat's stage.
 */
import { work } from "../../content/work";
import { CANVAS, SCENE, canvasStyle } from "./canvas";

import Hotspot from "../Hotspot.astro";
import ArtAsset from "./ArtAsset.astro";
import HeroCat from "./HeroCat.astro";
import HeroCityscape from "./HeroCityscape.astro";
import HeroSwing from "./HeroSwing.astro";
import HeroTop from "./HeroTop.astro";
import tree from "../../assets/illustrations/hero-tree.svg";

/** The buildings (and their hotspots) keep their original Figma numbers;
 *  this one transform scales and moves the whole layer onto the planet,
 *  landing Pulse and the "other projects" tower exactly where the new frame
 *  has them. */
const BUILDINGS = { x: -324, y: -146.6, scale: 1.0705 };

/** Where the tree's top-left lands, and its scale and tilt about that
 *  corner. Solved so the branch's top edge sits just above both chain tops
 *  of the swing's rest frame. */
const TREE = { x: 151.64, y: 218.48, scale: 1.1876, rotation: -2.39 };

/** The scene and buildings transforms, shared by every layer drawn in their
 *  coordinates (the scene itself, the front tower, the speech bubbles). */
const sceneStyle = `transform-origin: calc(${SCENE.origin.x} * var(--u)) calc(${SCENE.origin.y} * var(--u)); transform: scale(${SCENE.scale})`;
const buildingsStyle = `transform-origin: 0 0; transform: translate(calc(${BUILDINGS.x} * var(--u)), calc(${BUILDINGS.y} * var(--u))) scale(${BUILDINGS.scale})`;

/** The moon: Figma's ellipse cut flat across the bottom. */
const MOON_BOX = { x: 276, y: 277, width: 919, height: 592.972 };
const MOON =
  "M459.5 0C713.275 6.08251e-05 919 189.67 919 423.639C919 483.842 905.378 541.111 880.822 592.972H38.1777C13.6221 541.111 0 483.842 0 423.639C8.94483e-05 189.669 205.725 0 459.5 0Z";
---

<section class="hero-frame relative w-full" data-hero aria-label="Introduction">
  <div class="hero-canvas absolute inset-0">
    <!-- The planet scene, scaled as one (see SCENE in ./canvas.ts). -->
    <div class="hero-scene absolute inset-0" style={sceneStyle}>
      <!-- The planet: an ellipse cut flat across the bottom. -->
      <svg
        class="absolute"
        style={canvasStyle(MOON_BOX)}
        viewBox="0 0 919 592.972"
        aria-hidden="true"
      >
        <defs>
          <!-- The same outline as a 0–1 clip box, so the tree can be
               trimmed to the moon at any size. Grown a hair past the moon's
               edge (about 2 units) so the branches cover its soft rim
               instead of leaving a thin white line along it. -->
          <clipPath id="hero-moon-clip" clipPathUnits="objectBoundingBox">
            <path
              transform={`translate(0.5 0.7144) scale(1.005) translate(-0.5 -0.7144) scale(${1 / 919} ${1 / 592.972})`}
              d={MOON}
            />
          </clipPath>
        </defs>
        <path d={MOON} fill="white"></path>
      </svg>

      <!-- The tree the swing hangs from, behind the buildings: Figma's tree
           scaled up and tipped a touch so both chains hook onto its branch,
           and trimmed to the moon so it never blacks out stars beyond it. -->
      <div class="absolute" style={`${canvasStyle(MOON_BOX)}; clip-path: url(#hero-moon-clip)`}>
        <div
          class="absolute"
          style={`left: calc(${TREE.x - MOON_BOX.x} * var(--u)); top: calc(${TREE.y - MOON_BOX.y} * var(--u)); transform-origin: 0 0; transform: rotate(${TREE.rotation}deg)`}
        >
          <ArtAsset svg={tree} natural={{ w: 460.528, h: 322.037 }} size={460.528 * TREE.scale} />
        </div>
      </div>

      <div class="absolute inset-0" style={buildingsStyle}>
        <HeroCityscape part="back" />

        <!-- Building hotspots — invisible hit targets over the comic buildings. -->
        <div class="building-hotspots" data-building-hotspots>
          {
            work.buildingHotspots.map((spot) => (
              <Hotspot
                id={spot.id}
                label={spot.prompt}
                glowTarget={`[data-glow-id="${spot.id}"]`}
                x={spot.x}
                y={spot.y}
                width={spot.width}
                height={spot.height}
                data-target={spot.target}
                data-prompt={spot.prompt}
                data-x={spot.x}
                data-y={spot.y}
                data-width={spot.width}
              />
            ))
          }
        </div>
      </div>

      <HeroSwing />
    </div>

    <!-- Greeting, name, traits pill and rocket. -->
    <HeroTop />

    <!-- The Rive cat that runs along the planet and chases the cursor. -->
    <HeroCat />

    <!-- The tall "other projects" tower, in front of the cat so it runs
         behind it. -->
    <div class="hero-front absolute inset-0" style={sceneStyle}>
      <div class="absolute inset-0" style={buildingsStyle}>
        <HeroCityscape part="front" />
      </div>
    </div>

    <!-- Speech bubbles on top of everything, in the buildings' coordinates. -->
    <div class="hero-bubbles absolute inset-0" style={sceneStyle}>
      <div class="absolute inset-0" style={buildingsStyle}>
        <div class="building-bubble-host" data-bubble-host></div>
      </div>
    </div>
  </div>
</section>

<style define:vars={{ canvasW: CANVAS.width, canvasH: CANVAS.height }}>
  .hero-frame {
    container-type: inline-size;
    aspect-ratio: var(--canvasW) / var(--canvasH);
    /* Centred and capped, so on wide screens the scene keeps its size
       and the sky fills the sides. */
    max-width: 1440px;
    margin-inline: auto;
    /* Clip sideways only; vertically the swing and building bases may hang
       a touch past the frame. `clip`, unlike `hidden`, allows mixing with
       a visible axis. */
    overflow-x: clip;
    overflow-y: visible;
    /* Above the starry sky; the nav clearance is the sky scope's padding
       (pages/index.astro). */
    z-index: 1;
  }

  /* Above the cat (z 6) and the title (z 5). */
  .hero-front,
  .hero-bubbles {
    pointer-events: none;
    z-index: 7;
  }

  .hero-bubbles {
    z-index: 8;
  }

  .hero-canvas {
    /* One canvas unit = one Figma pixel, expressed as a share of the frame's
       width. This is what makes the fixed layout scale fluidly. */
    --u: calc(100cqw / var(--canvasW));
  }

  .building-bubble-host {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 9;
  }
</style>

<script>
  import {
    gsap,
    EASE,
    prefersReducedMotion,
    revealUnclaimed,
    showAll,
    targets,
  } from "../../scripts/gsap-setup.js";
  import { initHotspots } from "../../scripts/hotspot.js";

  const root = document.querySelector("[data-hero]");

  if (root) {
    if (prefersReducedMotion()) {
      showAll(root);
    } else {
      const portrait = targets(root, "portrait");
      const greeting = targets(root, "greeting");
      const headline = targets(root, "headline-line");

      const tl = gsap.timeline({ defaults: { ease: EASE.soft, duration: 0.7 } });

      tl.fromTo(portrait, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.9 }, 0)
        .fromTo(greeting, { opacity: 0, y: -18 }, { opacity: 1, y: 0 }, 0.15)
        .fromTo(headline, { opacity: 0, y: 40 }, { opacity: 1, y: 0, stagger: 0.12 }, 0.25);

      revealUnclaimed(root, [...portrait, ...greeting, ...headline]);
    }

    // Building hotspot → smooth scroll + SpeechBubble on hover. The glow
    // itself (toggling .is-glowing on the matching [data-glow-id] building)
    // is handled generically by initHotspots below — this block only owns
    // the hero-specific speech bubble.
    const host = root.querySelector("[data-bubble-host]");

    /** @type {HTMLElement | null} */
    let activeBubble = null;
    /** @type {HTMLElement | null} */
    let activeHotspot = null;

    // Per-building nudges for the hover bubble, layered on top of the
    // default centered-over-hotspot position. `overlap` is how far the
    // bubble's bottom tip sinks into the building's top edge (bigger =
    // lower); `leftShift` is how far left of the building's center it sits
    // (bigger = further left). Add/override an entry per building id to
    // tune just that one — anything not listed here falls back to DEFAULT.
    const DEFAULT_BUBBLE_OFFSET = { overlap: 206, leftShift: 108 };
    /** @type {Record<string, { overlap?: number; leftShift?: number }>} */
    const BUBBLE_OFFSETS = {
      pulse: {},
      // Middle building — pushed left of default, and 50 up (smaller
      // overlap = bubble sits higher, further from the building's top).
      heirloom: {
        leftShift: DEFAULT_BUBBLE_OFFSET.leftShift + 150,
        overlap: DEFAULT_BUBBLE_OFFSET.overlap - 50,
      },
      // Rightmost building — pushed left of default, and 50 up.
      "other-projects": {
        leftShift: DEFAULT_BUBBLE_OFFSET.leftShift + 70,
        overlap: DEFAULT_BUBBLE_OFFSET.overlap - 50,
      },
    };

    function clearBubble() {
      activeBubble?.remove();
      activeBubble = null;
      activeHotspot = null;
    }

    function showBubble(hotspot) {
      if (!host) return;
      if (activeHotspot === hotspot) return;
      clearBubble();
      activeHotspot = hotspot;

      const prompt = hotspot.getAttribute("data-prompt") || "";
      const spotX = Number(hotspot.getAttribute("data-x")) || 0;
      const spotY = Number(hotspot.getAttribute("data-y")) || 0;
      const spotWidth = Number(hotspot.getAttribute("data-width")) || 0;
      const id = hotspot.getAttribute("data-id") || "";
      const { overlap = DEFAULT_BUBBLE_OFFSET.overlap, leftShift = DEFAULT_BUBBLE_OFFSET.leftShift } =
        BUBBLE_OFFSETS[id] || {};

      const bubbleWidth = 220;
      const bubbleHeight = 200;

      const bubble = document.createElement("div");
      bubble.className = "speech-bubble hover-waver pointer-events-none origin-center absolute";
      bubble.setAttribute("data-speech-bubble", "");
      bubble.setAttribute("role", "tooltip");
      bubble.style.left = `calc(${spotX + spotWidth / 2 - bubbleWidth / 2 - leftShift} * var(--u, 1px))`;
      bubble.style.top = `calc(${spotY - bubbleHeight + overlap} * var(--u, 1px))`;
      bubble.style.width = `calc(${bubbleWidth} * var(--u, 1px))`;
      bubble.style.height = `calc(${bubbleHeight} * var(--u, 1px))`;
      bubble.style.setProperty("--waver-base", "-7.24deg");

      bubble.innerHTML = `
        <span class="block h-full w-full">
          <svg class="block h-full w-full" viewBox="0 0 276.673 259.138" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M138.336 6C211.423 6 270.673 56.5625 270.673 118.935C270.673 150.014 255.96 178.161 232.155 198.581C234.354 218.359 242.755 246.34 265.062 253.414L179.139 226.398C166.287 229.95 152.574 231.869 138.336 231.869C65.2487 231.869 6 181.307 6 118.935C6.00005 56.5626 65.2488 6.00022 138.336 6Z" fill="white"/>
            <path d="M138.336 6V0H138.336L138.336 6ZM270.673 118.935H276.673V118.935L270.673 118.935ZM232.155 198.581L228.249 194.027L225.842 196.092L226.192 199.244L232.155 198.581ZM265.062 253.414L263.262 259.138L266.875 247.695L265.062 253.414ZM179.139 226.398L180.938 220.675L179.248 220.143L177.541 220.615L179.139 226.398ZM138.336 231.869L138.336 237.869H138.336V231.869ZM6 118.935L0 118.935V118.935H6ZM138.336 6V12C209.037 12 264.673 60.7332 264.673 118.935L270.673 118.935L276.673 118.935C276.673 52.3918 213.81 0 138.336 0V6ZM270.673 118.935H264.673C264.673 148.026 250.916 174.582 228.249 194.027L232.155 198.581L236.062 203.135C261.004 181.739 276.673 152.003 276.673 118.935H270.673ZM232.155 198.581L226.192 199.244C227.34 209.568 230.12 222.254 235.699 233.44C241.276 244.622 249.99 254.929 263.248 259.133L265.062 253.414L266.875 247.695C257.827 244.825 251.186 237.605 246.437 228.084C241.69 218.565 239.17 207.372 238.119 197.918L232.155 198.581ZM265.062 253.414L266.861 247.69L180.938 220.675L179.139 226.398L177.339 232.122L263.262 259.138L265.062 253.414ZM179.139 226.398L177.541 220.615C165.21 224.022 152.034 225.869 138.336 225.869V231.869V237.869C153.113 237.869 167.364 235.877 180.737 232.182L179.139 226.398ZM138.336 231.869L138.336 225.869C67.635 225.869 12 177.136 12 118.935H6H0C0 185.477 62.8624 237.869 138.336 237.869L138.336 231.869ZM6 118.935L12 118.935C12 60.7333 67.6351 12.0002 138.336 12L138.336 6L138.336 0C62.8624 0.000229359 5.53131e-05 52.392 0 118.935L6 118.935Z" fill="black"/>
          </svg>
        </span>
        <div class="absolute inset-0 flex items-center justify-center px-[12%]">
          <p class="text-center font-script text-ink" style="font-size:calc(28 * var(--u, 1px));line-height:1.15;">${prompt}</p>
        </div>
      `;

      host.appendChild(bubble);
      activeBubble = bubble;
    }

    initHotspots(root, {
      onEnter: showBubble,
      onLeave: clearBubble,
      onClick: (hotspot) => {
        let target = hotspot.getAttribute("data-target");
        if (!target) return;
        // Fall back to the top of Work if a target ever goes missing.
        if (!document.querySelector(target)) target = "#work";
        if (prefersReducedMotion()) {
          document.querySelector(target)?.scrollIntoView();
          return;
        }
        gsap.to(window, {
          duration: 1.05,
          ease: EASE.glide,
          scrollTo: { y: target, offsetY: 72 },
        });
      },
    });
  }
</script>
