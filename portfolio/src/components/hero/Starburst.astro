---
/**
 * The radiating-lines-with-dot-endpoints decoration. Site-wide, same as
 * <Sparkle>.
 *
 *   <Starburst variant="small" size={169} rotation={-43.66} />
 *
 * The ray count is part of the exported artwork rather than a prop: generating
 * rays procedurally would mean redrawing the illustration instead of using the
 * real one. Add a new variant here if you draw a starburst with a different
 * number of rays.
 */
import ArtAsset from "./ArtAsset.astro";
import type { CanvasBox } from "./canvas";

import starburstLarge from "../../assets/decor/starburst.svg";
import starburstSmall from "../../assets/decor/starburst-small.svg";

export type StarburstVariant = "large" | "small";

const ARTWORK: Record<
  StarburstVariant,
  { svg: any; natural: { w: number; h: number } }
> = {
  large: { svg: starburstLarge, natural: { w: 268.107, h: 293.975 } },
  small: { svg: starburstSmall, natural: { w: 169.026, h: 195.19 } },
};

interface Props extends CanvasBox {
  variant?: StarburstVariant;
  size?: number;
  class?: string;
}

const {
  variant = "large",
  size,
  color = "var(--color-cream)",
  class: className,
  ...box
} = Astro.props;

const { svg, natural } = ARTWORK[variant];
---

<ArtAsset
  svg={svg}
  natural={natural}
  size={size}
  color={color}
  anim="starburst"
  class={className}
  {...box}
/>
