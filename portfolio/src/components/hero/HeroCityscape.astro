---
/**
 * The three building illustrations (Pulse, the heirloom house, and the
 * "other projects" tower). Hero.astro scales and moves this whole layer
 * onto the landing's planet, so the numbers here stay the original Figma
 * coordinates the building hotspots (content/work.ts) also use.
 *
 * `part` splits it in two so the Rive cat can run between them: "back"
 * (Pulse) sits behind the cat, "front" (the tall tower, then the house
 * over its foot) in front of it.
 *
 * `buildingOther` is a crop of a shared oversized master canvas (see
 * FillImage); `buildingPulse` is its own tightly framed drawing (spire
 * included), positioned with FillImage so its body lands exactly where the
 * old crop's did; `buildingHeirloom` is framed to its own bounds, so it
 * uses a plain cover crop.
 */
import { Image } from "astro:assets";
import FillImage from "../FillImage.astro";
import { canvasStyle } from "./canvas";
import { hero } from "../../content/hero";

interface Props {
  part: "back" | "front";
}

const { part } = Astro.props;
---

{
  part === "front" ? (
    <>
      <div
        class="absolute pointer-events-none hotspot-glow"
        data-glow-id="other-projects"
        style={canvasStyle({ x: 1185, y: 424.57, width: 258, height: 581 })}
      >
        <FillImage
          src={hero.images.buildingOther}
          alt=""
          cropTop={-21.09}
          cropLeft={-227.72}
          cropWidth={467.33}
          cropHeight={144.11}
        />
      </div>
      <div
        class="absolute pointer-events-none hotspot-glow"
        data-glow-id="heirloom"
        style={canvasStyle({ x: 887.9, y: 711.24, width: 487.2, height: 333.76 })}
      >
        <Image
          src={hero.images.buildingHeirloom}
          alt=""
          class="h-full w-full object-cover"
        />
      </div>
    </>
  ) : (
    <>
      <!-- Rotation lives on this outer, untransformed-by-hover wrapper — the lift
           effect below applies its own transform on the inner element, and inline
           and CSS transforms on the SAME element don't compose (inline always
           wins), so they have to live on separate nodes. -->
      <div
        class="absolute"
        style={canvasStyle({
          x: 731.72,
          y: 418.47,
          width: 418.927,
          height: 617.494,
          rotation: -1.26,
        })}
      >
        <div class="h-full w-full pointer-events-none hotspot-glow" data-glow-id="pulse">
          <FillImage
            src={hero.images.buildingPulse}
            alt=""
            cropTop={-4.02}
            cropLeft={1.46}
            cropWidth={93.85}
            cropHeight={102.59}
          />
        </div>
      </div>

    </>
  )
}
