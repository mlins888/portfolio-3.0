---
/**
 * The illustrated lower-band scene: two flat "night sky" panels, the three
 * building illustrations, the character-on-swing artwork (a colourful shape
 * burst that slowly rotates + pulses, with the line-drawn character resting
 * still on top — see the <style> block) — all placed at their exact Figma coordinates on the hero
 * canvas. Paint order matches the Figma layer order exactly (the character
 * scene is painted after the first two buildings because it's a
 * transparent-background cutout that partially overlaps them). The character
 * plays its swing loop once after the intro, then again on hover (desktop) or
 * tap (touch).
 *
 * `buildingOther` is a crop of a shared oversized master canvas (see
 * FillImage); `buildingPulse` is its own tightly framed drawing (spire
 * included), positioned with FillImage so its body lands exactly where the
 * old crop's did; `buildingHackduke` and the scene artwork are already
 * framed to their own bounds, so they use a plain cover crop.
 */
import { Image } from "astro:assets";
import FillImage from "../FillImage.astro";
import ArtAsset from "./ArtAsset.astro";
import { canvasStyle } from "./canvas";
import { hero } from "../../content/hero";

import panelA from "../../assets/decor/hero-scene-panel-a.svg";
import panelB from "../../assets/decor/hero-scene-panel-b.svg";

const sprite = hero.images.sceneCharacterSprite;
---

<ArtAsset svg={panelA} natural={{ w: 676.5, h: 586.5 }} x={721} y={394} />
<ArtAsset svg={panelB} natural={{ w: 295, h: 587 }} x={1105} y={394} />

<div
  class="absolute pointer-events-none hotspot-glow"
  data-glow-id="other-projects"
  style={canvasStyle({ x: 1185, y: 444.57, width: 258, height: 581 })}
>
  <FillImage
    src={hero.images.buildingOther}
    alt=""
    cropTop={-21.09}
    cropLeft={-227.72}
    cropWidth={467.33}
    cropHeight={144.11}
  />
</div>

<!-- Rotation lives on this outer, untransformed-by-hover wrapper — the lift
     effect below applies its own transform on the inner element, and inline
     and CSS transforms on the SAME element don't compose (inline always
     wins), so they have to live on separate nodes. -->
<div
  class="absolute"
  style={canvasStyle({
    x: 731.72,
    y: 438.47,
    width: 418.927,
    height: 617.494,
    rotation: -1.26,
  })}
>
  <div class="h-full w-full pointer-events-none hotspot-glow" data-glow-id="pulse">
    <FillImage
      src={hero.images.buildingPulse}
      alt=""
      cropTop={-4.02}
      cropLeft={1.46}
      cropWidth={93.85}
      cropHeight={102.59}
    />
  </div>
</div>

<!-- Scene artwork, split into two layers: a colourful shape burst that
     rotates + pulses on a slow perpetual loop, and the line-drawn
     character on top of it. Same footprint the single combined image used
     before. The box deliberately doesn't clip: as the splash rotates and
     swells it's meant to spill over the coral panel's edge onto the cream
     border, not get sliced off at it. -->
<div
  class="scene-art absolute pointer-events-none"
  style={canvasStyle({ x: 31, y: 389, width: 962, height: 668 })}
  data-anim="portrait"
>
  <Image
    src={hero.images.sceneSplash}
    alt=""
    aria-hidden="true"
    class="scene-art__splash absolute inset-0 h-full w-full object-cover"
  />
  <!-- The character is a 12fps hand-drawn swing loop. The still image is
       its rest frame and is what no-JS / reduced-motion visitors see; the script
       below swaps in the sprite sheet once it has loaded and decoded. -->
  <div
    class="scene-art__character absolute"
    data-swing
    data-sprite={sprite.image.src}
    data-columns={sprite.columns}
    data-rows={sprite.rows}
    data-frames={sprite.frames}
    data-fps={sprite.fps}
    data-rest-frame={sprite.restFrame}
  >
    <Image
      src={hero.images.sceneCharacter}
      alt={hero.images.sceneAlt}
      class="scene-art__poster block h-full w-full"
    />
    <div
      class="scene-art__sprite absolute inset-0"
      aria-hidden="true"
      style={`background-size: ${sprite.columns * 100}% ${sprite.rows * 100}%`}
    >
    </div>
  </div>
</div>

<div
  class="absolute pointer-events-none hotspot-glow"
  data-glow-id="hackduke"
  style={canvasStyle({ x: 944, y: 747, width: 435, height: 298 })}
>
  <Image
    src={hero.images.buildingHackduke}
    alt=""
    class="h-full w-full object-cover"
  />
</div>

<style>
  .scene-art__splash {
    transform-origin: center;
    transform: rotate(-2deg) scale(1.04);
    animation: scene-splash-idle 11s ease-in-out infinite;
  }

  @keyframes scene-splash-idle {
    0%,
    100% {
      transform: rotate(-2deg) scale(1.04);
    }
    50% {
      transform: rotate(2deg) scale(1.09);
    }
  }

  /* Placement matched to where the character sat in the original combined
     artwork. The frames are cropped (1309 × 1499) so frame 1 lands exactly
     where the old single still did: same left edge, same scale, a little
     extra width on the right for the frames where the swing kicks out. */
  .scene-art__character {
    left: 14%;
    top: 49.5%;
    width: 58.61%;
    aspect-ratio: 1309 / 1499;
    transform: translateY(-50%);
    /* The wrapper ignores pointers so the buildings behind stay hoverable;
       the character opts back in to drive the animation. */
    pointer-events: auto;
  }

  .scene-art__sprite {
    background-repeat: no-repeat;
    visibility: hidden;
  }

  .scene-art__character.is-ready .scene-art__sprite {
    visibility: visible;
  }

  .scene-art__character.is-ready .scene-art__poster {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-art__splash {
      animation: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from "../../scripts/gsap-setup.js";

  /** Lands just after the hero intro timeline settles (~1.3s). */
  const AUTOPLAY_DELAY_MS = 1400;

  document.querySelectorAll<HTMLElement>("[data-swing]").forEach((el) => {
    if (prefersReducedMotion()) return;

    const sheet = el.querySelector<HTMLElement>(".scene-art__sprite");
    const src = el.dataset.sprite;
    if (!sheet || !src) return;

    const columns = Number(el.dataset.columns);
    const rows = Number(el.dataset.rows);
    const frames = Number(el.dataset.frames);
    const frameMs = 1000 / Number(el.dataset.fps);
    const rest = Number(el.dataset.restFrame) || 0;

    let frame = rest;
    let running = false;
    let hovering = false;
    /** Extra full loops still owed to a tap / the autoplay. */
    let loopsOwed = 0;
    let last = 0;

    function show(n: number) {
      const col = n % columns;
      const row = Math.floor(n / columns);
      sheet!.style.backgroundPosition = `${(col / (columns - 1)) * 100}% ${(row / (rows - 1)) * 100}%`;
    }

    function tick(now: number) {
      if (now - last >= frameMs) {
        // Advance by whole frames against the clock so a slow tab doesn't
        // stretch the loop, without skipping more than a frame at a time.
        last = now - ((now - last) % frameMs);
        frame = (frame + 1) % frames;
        if (frame === rest) {
          // Only ever stop on the rest pose, never mid-swing.
          if (loopsOwed > 0) loopsOwed--;
          if (!hovering && loopsOwed === 0) {
            show(rest);
            running = false;
            return;
          }
        }
        show(frame);
      }
      requestAnimationFrame(tick);
    }

    function play(loops = 0) {
      loopsOwed = Math.max(loopsOwed, loops);
      if (running || !el.classList.contains("is-ready")) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(tick);
    }

    const img = new Image();
    img.src = src;
    img
      .decode()
      .then(() => {
        sheet.style.backgroundImage = `url("${src}")`;
        show(rest);
        el.classList.add("is-ready");
        setTimeout(() => play(1), Math.max(0, AUTOPLAY_DELAY_MS - performance.now()));
      })
      .catch(() => {
        // Sprite failed to load: the still poster just stays put.
      });

    el.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      hovering = true;
      play();
    });
    el.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      hovering = false;
    });
    el.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      play(1);
    });
  });
</script>

