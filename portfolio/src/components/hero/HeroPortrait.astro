---
/**
 * Spotlight circle plus the figure illustration.
 *
 * The illustration is a swappable image reference, not inlined paths — hand it
 * a different import from src/assets/illustrations and nothing else changes.
 * The crop numbers below are the Figma frame's: the artwork is deliberately
 * larger than its window so the figure's leg breaks out of the circle.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import ArtAsset from "./ArtAsset.astro";
import { canvasStyle, css, u, type CanvasBox } from "./canvas";

import spotlight from "../../assets/illustrations/portrait-circle.svg";

interface Props extends CanvasBox {
  illustration: ImageMetadata;
  alt: string;
  /** Diameter of the spotlight circle, in canvas units. */
  circleSize?: number;
  circleColor?: string;
  class?: string;
}

const {
  illustration,
  alt,
  circleSize = 575,
  circleColor = "var(--color-ink)",
  class: className,
  ...box
} = Astro.props;
---

<div class:list={[className]} style={canvasStyle(box)}>
  <ArtAsset
    svg={spotlight}
    natural={{ w: 575, h: 575 }}
    size={circleSize}
    x={107}
    y={0}
    color={circleColor}
  />

  <div
    class="absolute overflow-hidden"
    style={css({ left: u(0), top: u(2), width: u(705), height: u(645) })}
    data-anim="portrait"
  >
    <Image
      src={illustration}
      alt={alt}
      class="absolute max-w-none"
      style={css({
        left: "-39.16%",
        top: "-20.45%",
        width: "180.15%",
        height: "136.89%",
      })}
    />
  </div>
</div>
