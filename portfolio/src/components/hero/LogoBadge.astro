---
/**
 * Corner cat mark, cropped from the shared hand-drawn illustration canvas
 * (see FillImage for why this is a crop rather than a standalone file).
 */
import type { ImageMetadata } from "astro";
import FillImage from "../FillImage.astro";
import { canvasStyle, type CanvasBox } from "./canvas";

interface Props extends CanvasBox {
  logo: ImageMetadata;
  alt: string;
  class?: string;
}

const { logo, alt, class: className, ...box } = Astro.props;
---

<div class:list={[className]} style={canvasStyle(box)} data-logo>
  <div class="absolute inset-0 bg-cream" aria-hidden="true"></div>
  <FillImage
    src={logo}
    alt={alt}
    cropTop={-198.96}
    cropLeft={-58.18}
    cropWidth={229.37}
    cropHeight={349.63}
  />
</div>
