---
/**
 * The character on her swing, hanging from the tree on the landing's
 * planet. A 12fps hand-drawn swing loop (sprite sheet) that plays once
 * after the intro, then again on hover (desktop) or tap (touch); the still
 * rest frame is what no-JS and reduced-motion visitors see.
 */
import { Image } from "astro:assets";
import { canvasStyle } from "./canvas";
import { hero } from "../../content/hero";

const sprite = hero.images.sceneCharacterSprite;

/** Figma: 800.24 × 556.1, rotated −7.76° about (560, 697.5), nudged by its
 *  1.64% / 0.08% inner offset. */
const BOX = { x: 173, y: 419.9, width: 800.24, height: 556.1, rotation: -7.76 };
---

<!-- The box is the artwork's full 2360 × 1640 canvas, placed and tilted
     as in Figma (800 × 556 at −7.76°); the character sits inside it at the
     spot it always has within that canvas. -->
<div class="scene-art absolute pointer-events-none" style={canvasStyle(BOX)}>
  <!-- The intro's scale-in runs on this inner layer, so it never fights
       the tilt on the box. -->
  <div class="absolute inset-0" data-anim="portrait">
    <!-- The character is a 12fps hand-drawn swing loop. The still image is
         its rest frame and is what no-JS / reduced-motion visitors see; the script
         below swaps in the sprite sheet once it has loaded and decoded. -->
    <div
      class="scene-art__character absolute"
      data-swing
      data-sprite={sprite.image.src}
      data-columns={sprite.columns}
      data-rows={sprite.rows}
      data-frames={sprite.frames}
      data-fps={sprite.fps}
      data-rest-frame={sprite.restFrame}
      data-tilt={BOX.rotation}
    >
      <Image
        src={hero.images.sceneCharacter}
        alt={hero.images.sceneAlt}
        class="scene-art__poster block h-full w-full"
      />
      <div
        class="scene-art__sprite absolute inset-0"
        aria-hidden="true"
        style={`background-size: ${sprite.columns * 100}% ${sprite.rows * 100}%`}
      >
      </div>
    </div>
  </div>
</div>

<style>
  /* Placement matched to where the character sat in the original combined
     artwork. The frames are cropped (1309 × 1499) so frame 1 lands exactly
     where the old single still did: same left edge, same scale, a little
     extra width on the right for the frames where the swing kicks out,
     raised so the tops of the chains reach the tree branch. */
  .scene-art__character {
    left: 14%;
    top: 45.47%;
    width: 58.61%;
    aspect-ratio: 1309 / 1499;
    transform: translateY(-50%);
    /* Ignores pointers too, so the building hotspots under its (mostly
       empty) box stay hoverable; the script hit-tests the drawing itself. */
    pointer-events: none;
  }

  .scene-art__sprite {
    background-repeat: no-repeat;
    visibility: hidden;
  }

  .scene-art__character.is-ready .scene-art__sprite {
    visibility: visible;
  }

  .scene-art__character.is-ready .scene-art__poster {
    visibility: hidden;
  }
</style>

<script>
  import { prefersReducedMotion } from "../../scripts/gsap-setup.js";

  /** Lands just after the hero intro timeline settles (~1.3s). */
  const AUTOPLAY_DELAY_MS = 1400;

  document.querySelectorAll<HTMLElement>("[data-swing]").forEach((el) => {
    if (prefersReducedMotion()) return;

    const sheet = el.querySelector<HTMLElement>(".scene-art__sprite");
    const src = el.dataset.sprite;
    if (!sheet || !src) return;

    const columns = Number(el.dataset.columns);
    const rows = Number(el.dataset.rows);
    const frames = Number(el.dataset.frames);
    const frameMs = 1000 / Number(el.dataset.fps);
    const rest = Number(el.dataset.restFrame) || 0;

    let frame = rest;
    let running = false;
    let hovering = false;
    /** Extra full loops still owed to a tap / the autoplay. */
    let loopsOwed = 0;
    let last = 0;

    function show(n: number) {
      const col = n % columns;
      const row = Math.floor(n / columns);
      sheet!.style.backgroundPosition = `${(col / (columns - 1)) * 100}% ${(row / (rows - 1)) * 100}%`;
    }

    function tick(now: number) {
      if (now - last >= frameMs) {
        // Advance by whole frames against the clock so a slow tab doesn't
        // stretch the loop, without skipping more than a frame at a time.
        last = now - ((now - last) % frameMs);
        frame = (frame + 1) % frames;
        if (frame === rest) {
          // Only ever stop on the rest pose, never mid-swing.
          if (loopsOwed > 0) loopsOwed--;
          if (!hovering && loopsOwed === 0) {
            show(rest);
            running = false;
            return;
          }
        }
        show(frame);
      }
      requestAnimationFrame(tick);
    }

    function play(loops = 0) {
      loopsOwed = Math.max(loopsOwed, loops);
      if (running || !el.classList.contains("is-ready")) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(tick);
    }

    const img = new Image();
    img.src = src;
    img
      .decode()
      .then(() => {
        sheet.style.backgroundImage = `url("${src}")`;
        show(rest);
        el.classList.add("is-ready");
        setTimeout(() => play(1), Math.max(0, AUTOPLAY_DELAY_MS - performance.now()));
      })
      .catch(() => {
        // Sprite failed to load: the still poster just stays put.
      });

    // Hit-testing against the drawing, not the box. The frames share a crop
    // with generous empty margins (room for the swing's kick-out), so the
    // element's rectangle is much bigger than the character. A small alpha
    // mask of the still frame — grown by a couple of cells so the edge isn't
    // fiddly — decides whether the pointer is actually over her. Until the
    // mask is ready, the whole box counts.
    const MASK_W = 128;
    const MASK_PAD = 2;
    let mask: Uint8Array | null = null;
    let maskH = 0;

    const poster = el.querySelector<HTMLImageElement>(".scene-art__poster");
    if (poster) {
      const still = new Image();
      still.src = poster.currentSrc || poster.src;
      still
        .decode()
        .then(() => {
          maskH = Math.round((MASK_W * still.naturalHeight) / still.naturalWidth);
          const canvas = document.createElement("canvas");
          canvas.width = MASK_W;
          canvas.height = maskH;
          const ctx = canvas.getContext("2d", { willReadFrequently: true });
          if (!ctx) return;
          ctx.drawImage(still, 0, 0, MASK_W, maskH);
          const alpha = ctx.getImageData(0, 0, MASK_W, maskH).data;
          const grown = new Uint8Array(MASK_W * maskH);
          for (let y = 0; y < maskH; y++) {
            for (let x = 0; x < MASK_W; x++) {
              if (alpha[(y * MASK_W + x) * 4 + 3] < 40) continue;
              for (let dy = -MASK_PAD; dy <= MASK_PAD; dy++) {
                for (let dx = -MASK_PAD; dx <= MASK_PAD; dx++) {
                  const gx = x + dx;
                  const gy = y + dy;
                  if (gx >= 0 && gx < MASK_W && gy >= 0 && gy < maskH) grown[gy * MASK_W + gx] = 1;
                }
              }
            }
          }
          mask = grown;
        })
        .catch(() => {
          // No mask: fall back to the whole box.
        });
    }

    // The box is tilted (and scaled with the scene), so map the pointer
    // back into its own, untilted frame before looking it up in the mask.
    const tilt = (Number(el.dataset.tilt) * Math.PI) / 180;
    const cos = Math.cos(tilt);
    const sin = Math.sin(tilt);

    function overArt(e: PointerEvent) {
      const r = el.getBoundingClientRect();
      const w = el.offsetWidth;
      const h = el.offsetHeight;
      // Screen px per layout px, recovered from the tilted bounding box.
      const k = r.width / (w * Math.abs(cos) + h * Math.abs(sin));
      const dx = (e.clientX - (r.left + r.width / 2)) / k;
      const dy = (e.clientY - (r.top + r.height / 2)) / k;
      const lx = dx * cos + dy * sin + w / 2;
      const ly = -dx * sin + dy * cos + h / 2;
      if (lx < 0 || lx > w || ly < 0 || ly > h) return false;
      if (!mask) return true;
      const x = Math.floor((lx / w) * MASK_W);
      const y = Math.floor((ly / h) * maskH);
      return x >= 0 && x < MASK_W && y >= 0 && y < maskH && mask[y * MASK_W + x] === 1;
    }

    // The character ignores pointers (see the CSS), so listen page-wide.
    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        const over = overArt(e);
        if (over === hovering) return;
        hovering = over;
        if (over) play();
      },
      { passive: true },
    );
    window.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      if (overArt(e)) play(1);
    });
  });
</script>
