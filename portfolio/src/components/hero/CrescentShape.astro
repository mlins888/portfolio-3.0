---
/** Cream crescent that sits behind the geometric cluster. */
import ArtAsset from "./ArtAsset.astro";
import type { CanvasBox } from "./canvas";

import crescent from "../../assets/decor/crescent.svg";

const NATURAL = { w: 197, h: 194 };

interface Props extends CanvasBox {
  size?: number;
  class?: string;
}

const {
  size,
  color = "var(--color-cream)",
  class: className,
  ...box
} = Astro.props;
---

<ArtAsset
  svg={crescent}
  natural={NATURAL}
  size={size}
  color={color}
  class={className}
  {...box}
/>
