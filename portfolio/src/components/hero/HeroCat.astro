---
/**
 * The Rive cat that runs along the top of the landing's planet
 * (public/rive/cat.riv, artboard + state machine both "Cat"). Rive owns how
 * the cat moves; this script owns where it is:
 *
 *  - cursor in the top half of the landing (its stage) → run over along
 *    the planet's curve, pounce, and hang from the cursor
 *  - cursor anywhere else → run to the nearest point on its arc and wait
 *
 * The state machine reads three View Model booleans (`running`, `waiting`,
 * `holding`) plus a `blink` trigger fired at random. Clicking on the stage
 * makes the cat let go. Touch screens get a sitting cat; reduced motion
 * gets a still one.
 *
 * Positions are in canvas units (see ./canvas.ts) so the cat scales with
 * the landing. PLANET matches the planet drawn in Hero.astro.
 */
import { canvasStyle } from "./canvas";
import mouseCursor from "../../assets/illustrations/cursor-mouse.svg";

/** The cat's stage: the top half of the 1440 × 963 landing. */
const STAGE = { x: 0, y: 0, width: 1440, height: 481.5 };
/** Height of the cat's canvas, in canvas units. */
const CAT_H = 230;
/** The mouse cursor shown on the stage; the hotspot is its nose. */
const cursor = `url("${mouseCursor.src}") 5 21, auto`;
---

<div class="hero-cat" data-hero-cat data-cursor={cursor} style={canvasStyle(STAGE)}>
  <canvas class="hero-cat__canvas" data-hero-cat-canvas style={`--cat-h: ${CAT_H}`} aria-hidden="true"></canvas>
</div>

<style>
  /* Fills the stage so the script can measure it; clicks pass through to
     the hotspots and links underneath. */
  .hero-cat {
    pointer-events: none;
    z-index: 6;
  }

  .hero-cat__canvas {
    position: absolute;
    left: 0;
    top: 0;
    height: calc(var(--cat-h) * var(--u, 1px));
    /* Width is set from the artboard's aspect ratio once the file loads. */
    width: 0;
    visibility: hidden;
    will-change: transform;
  }

  .hero-cat__canvas.is-ready {
    visibility: visible;
  }
</style>

<style is:global>
  /* While the cursor is over the stage it turns into a mouse for the cat
     to chase, links and all. */
  html.is-cat-cursor,
  html.is-cat-cursor * {
    cursor: var(--catCursor) !important;
  }
</style>

<script>
  import { Rive, Layout, Fit, Alignment, RuntimeLoader } from "@rive-app/canvas";
  import riveWasm from "@rive-app/canvas/rive.wasm?url";
  import { gsap, prefersReducedMotion } from "../../scripts/gsap-setup.js";
  import { SCENE } from "./canvas";

  // Self-host the runtime instead of pulling it from a CDN.
  RuntimeLoader.setWasmUrl(riveWasm);

  /**
   * Where things sit in the artboard, as fractions of its width/height.
   * FOOT is the point that stands on the planet; PAW is the point
   * pinned to the cursor while hanging (the hang animation's pivot).
   */
  const FOOT = { x: 0.49, y: 0.9 };
  /** `wait` crouches with its feet higher up the artboard than the others. */
  const WAIT_FOOT_Y = 0.812;
  const PAW = { x: 0.82, y: 0.16 };
  /** The planet it runs on (canvas units): an ellipse, centre and radii,
   *  as drawn in Figma and then scaled with the rest of the scene. */
  const PLANET = {
    cx: SCENE.origin.x + (735.5 - SCENE.origin.x) * SCENE.scale,
    cy: SCENE.origin.y + (700.64 - SCENE.origin.y) * SCENE.scale,
    rx: 459.5 * SCENE.scale,
    ry: 423.64 * SCENE.scale,
  };
  /** How far round the planet it runs, either side of the top (degrees).
   *  Keeps it on the gentle top of the curve. */
  const ARC_LIMIT = 42;
  /** Canvas width of the stage, to turn canvas units into px. */
  const STAGE_UNITS = 1440;
  /** Top running speed, in stage widths per second. */
  const MAX_SPEED = 0.3;
  /** How quickly it gets up to speed (stage widths / s²). */
  const ACCEL = 0.9;
  /** How hard it brakes coming into a stop (stage widths / s²). Lower =
   *  it starts slowing down further out. */
  const BRAKE = 0.8;
  /** From a standstill, the target has to be this far away (share of cat
   *  width) before it bothers to get up and run. Ignores cursor wiggles. */
  const START_DIST = 0.12;
  /** `running` turns on above this speed and off below the lower one
   *  (stage widths / s), so the run cycle doesn't flicker on and off. */
  const RUN_ON = 0.04;
  const RUN_OFF = 0.015;
  /** It only turns around once the cursor is this far behind its feet
   *  (share of cat width). */
  const TURN_MARGIN = 0.06;
  /** How long a turnaround takes (s). */
  const TURN_TIME = 0.16;
  /** It pounces when the cursor is within this distance (share of cat
   *  width) of its body, measured in any direction, so a cursor up and to
   *  the side counts as much as one straight ahead. */
  const POUNCE_RADIUS = 0.55;
  /** Where its body sits, as a height above its feet along the planet's
   *  normal (share of cat height): the point the radius is measured from. */
  const BODY_HEIGHT = 0.42;
  /** How far the hanging cat dangles below its paws (share of cat height).
   *  It won't pounce, or keep hold, where that would sink it into the
   *  planet. */
  const HANG_DROP = 0.55;
  /** While already hanging it gets a little slack before it lets go, so
   *  skimming the surface doesn't flicker it on and off. */
  const HANG_SLACK = 0.12;
  /** How close (px) counts as "arrived" when heading for a target. */
  const ARRIVE = 3;
  /** How long the leap from the floor to the cursor takes (match `pounce`). */
  const LEAP = 0.45;
  /** After being shaken off by a click, the cat sulks this long (s)
   *  before it chases again. */
  const DROPPED_PAUSE = 1.2;
  /** While hanging, how quickly the cat's grip catches up with the cursor
   *  (share of the gap closed per 60fps frame). Lower = heavier cat. */
  const GRIP_FOLLOW = 0.3;
  /** If the cursor gets this far ahead of its grip (share of cat width),
   *  the cat loses hold and falls. */
  const SLIP = 0.3;
  /** At the end of a pounce, the cursor must still be this close to where
   *  the cat jumped (share of cat width) for it to catch on. */
  const CATCH = 0.18;
  /** Pause after slipping off or missing, before it chases again (s). */
  const SLIPPED_PAUSE = 0.5;
  /** While hanging, the cat swings as it's dragged: degrees of tilt per
   *  stage width per second of sideways drag, capped at SWAY_MAX. */
  const SWAY_GAIN = 20;
  const SWAY_MAX = 14;
  /** The swing's spring: stiffness and damping (a little bouncy). */
  const SWAY_STIFF = 120;
  const SWAY_DAMP = 13;
  /** How far it squashes when it lands from a drop (scale Y). */
  const LAND_SQUASH = 0.92;

  const host = document.querySelector<HTMLElement>("[data-hero-cat]");
  const canvas = host?.querySelector<HTMLCanvasElement>("[data-hero-cat-canvas]");

  if (host && canvas) {
    const still = prefersReducedMotion();
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    const rive = new Rive({
      src: "/rive/cat.riv",
      canvas,
      artboard: "Cat",
      stateMachine: "Cat",
      autoplay: !still,
      autoBind: true,
      layout: new Layout({ fit: Fit.Contain, alignment: Alignment.Center }),
      onLoad: () => start(),
      // No cat, so nothing will draw the traits pill in: show it outright.
      onLoadError: () => window.dispatchEvent(new CustomEvent("herocat:reveal")),
    });

    function start() {
      const b = rive.bounds;
      const aspect = (b.maxX - b.minX) / (b.maxY - b.minY);
      canvas!.style.aspectRatio = String(aspect);
      canvas!.style.width = "auto";

      const vm = rive.viewModelInstance;
      const input = {
        running: vm?.boolean("running"),
        waiting: vm?.boolean("waiting"),
        holding: vm?.boolean("holding"),
        blink: vm?.trigger("blink"),
      };
      const foot = { y: FOOT.y };
      const set = (name: "running" | "waiting" | "holding", on: boolean) => {
        const prop = input[name];
        if (!prop || prop.value === on) return;
        prop.value = on;
        // Slide the floor line along with the state machine's blend.
        if (name === "waiting") gsap.to(foot, { y: on ? WAIT_FOOT_Y : FOOT.y, duration: 0.15, overwrite: true });
      };

      // Sizes, re-measured on resize.
      let stage = host!.getBoundingClientRect();
      let catW = 0;
      let catH = 0;
      function measure() {
        stage = host!.getBoundingClientRect();
        catW = canvas!.offsetWidth;
        catH = canvas!.offsetHeight;
        rive.resizeDrawingSurfaceToCanvas();
      }
      measure();

      // The cat's state, in px relative to the stage's top-left (which is
      // also the landing canvas's top-left).
      const planet = () => {
        const k = stage.width / STAGE_UNITS;
        return { cx: PLANET.cx * k, cy: PLANET.cy * k, rx: PLANET.rx * k, ry: PLANET.ry * k };
      };
      const ARC_SIN = Math.sin((ARC_LIMIT * Math.PI) / 180);
      const minX = () => planet().cx - planet().rx * ARC_SIN;
      const maxX = () => planet().cx + planet().rx * ARC_SIN;
      /** The planet's surface under x: its height, and its slope (radians,
       *  positive where it falls away to the right). */
      function surface(px: number) {
        const p = planet();
        const t = Math.max(-0.999, Math.min(0.999, (px - p.cx) / p.rx));
        const root = Math.sqrt(1 - t * t);
        return { y: p.cy - p.ry * root, tilt: Math.atan((p.ry * t) / (p.rx * root)) };
      }
      // Starts in the bottom-left corner, so its first run carries it past
      // the traits pill (HeroTop.astro draws the pill in behind it).
      let x = minX();
      /** Running velocity, px/s. */
      let v = 0;
      /** Heading for a target (vs. settled), for the START_DIST deadband. */
      let moving = false;
      let runningOn = false;
      /** Which way it faces, and the animated flip that follows it. */
      let facing = 1;
      const turn = { s: 1 };
      /** 0 = standing on the floor, 1 = hanging from the cursor. Split in
       *  two so the leap can rise and travel on different curves (an arc). */
      const lift = { x: 0, y: 0 };
      const lifted = () => lift.x > 0 || lift.y > 0;
      /** Tilt (deg) while hanging, and its spring velocity. */
      const sway = { a: 0, va: 0 };
      /** Landing squash (scale Y, pinned at the feet). */
      const squash = { s: 1 };
      let holding = false;
      /** Mid-pounce: committed to where the cursor was when it jumped. */
      let leaping = false;
      /** gsap time until which the cat sits out after being dropped. */
      let sulkUntil = 0;
      let pointer: { x: number; y: number } | null = null;
      /** Where its paws are hanging on: trails the cursor while held. */
      const grip = { x: 0, y: 0 };
      let gripPrevX = 0;

      let lastCentre = NaN;
      function place() {
        // Standing: FOOT on the planet at x, tilted to its curve. Hanging:
        // PAW on the cursor, upright.
        const pawX = facing === 1 ? PAW.x : 1 - PAW.x;
        const ground = surface(x);
        const groundLeft = x - catW * FOOT.x;
        const groundTop = ground.y - catH * foot.y;
        const hangLeft = grip.x - catW * pawX;
        const hangTop = grip.y - catH * PAW.y;
        const left = groundLeft + (hangLeft - groundLeft) * lift.x;
        const top = groundTop + (hangTop - groundTop) * lift.y;
        // Read right to left: flip, squash and tilt about the feet, swing
        // about the paws, then move into place. Pivots are offsets from the
        // centre. The tilt eases off as it leaps, so it hangs upright.
        const px = (pawX - 0.5) * catW;
        const py = (PAW.y - 0.5) * catH;
        const fx = ((facing === 1 ? FOOT.x : 1 - FOOT.x) - 0.5) * catW;
        const fy = (foot.y - 0.5) * catH;
        const tilt = (ground.tilt * 180) / Math.PI * (1 - lift.y);
        canvas!.style.transform =
          `translate(${left}px, ${top}px) ` +
          `translate(${px}px, ${py}px) rotate(${(sway.a * lift.y).toFixed(3)}deg) translate(${-px}px, ${-py}px) ` +
          `translate(${fx}px, ${fy}px) rotate(${tilt.toFixed(3)}deg) scaleY(${squash.s}) translate(${-fx}px, ${-fy}px) ` +
          `scaleX(${turn.s})`;
        const centre = stage.left + left + catW / 2;
        if (centre !== lastCentre) {
          lastCentre = centre;
          window.dispatchEvent(new CustomEvent("herocat:move", { detail: { clientX: centre } }));
        }
      }

      place();
      canvas!.classList.add("is-ready");

      // A cat that won't run past the traits pill can't draw it in.
      if (still || !canHover) window.dispatchEvent(new CustomEvent("herocat:reveal"));

      if (still) return;

      // Blink every few seconds, at uneven intervals.
      (function blinkLater() {
        gsap.delayedCall(2 + Math.random() * 4, () => {
          input.blink?.trigger();
          blinkLater();
        });
      })();

      // Touch screens: no cursor to chase, so the cat just sits.
      if (!canHover) return;

      // Cursor in client px; `pointer` is re-derived from it whenever the
      // stage moves under a still cursor (scrolling).
      let client: { x: number; y: number } | null = null;
      document.documentElement.style.setProperty("--catCursor", host!.dataset.cursor ?? "auto");
      const track = () => {
        pointer = client && { x: client.x - stage.left, y: client.y - stage.top };
        document.documentElement.classList.toggle("is-cat-cursor", inBand(pointer));
      };
      window.addEventListener(
        "pointermove",
        (e) => {
          client = { x: e.clientX, y: e.clientY };
          track();
        },
        { passive: true },
      );
      document.documentElement.addEventListener("pointerleave", () => {
        client = null;
        track();
      });
      window.addEventListener(
        "scroll",
        () => {
          stage = host!.getBoundingClientRect();
          track();
        },
        { passive: true },
      );
      window.addEventListener("resize", () => {
        measure();
        x = Math.min(Math.max(x, minX()), maxX());
      });

      const inBand = (p: { x: number; y: number } | null) =>
        !!p && p.x >= 0 && p.x <= stage.width && p.y >= 0 && p.y <= stage.height;

      /** The planet's surface height under x, or Infinity off its sides. */
      function groundAt(px: number) {
        const m = planet();
        const t = (px - m.cx) / m.rx;
        return Math.abs(t) >= 1 ? Infinity : m.cy - m.ry * Math.sqrt(1 - t * t);
      }

      /** Could it hang from this point without its feet sinking into the
       *  planet? (`slack` lets them dip in a little.) */
      const roomToHang = (p: { x: number; y: number } | null, slack = 0) =>
        !!p && p.y + catH * (HANG_DROP - slack) <= groundAt(p.x);

      /** The middle of its body, standing on the planet at x. */
      function body() {
        const g = surface(x);
        return {
          x: x + Math.sin(g.tilt) * catH * BODY_HEIGHT,
          y: g.y - Math.cos(g.tilt) * catH * BODY_HEIGHT,
        };
      }

      function turnTo(dir: number) {
        if (dir === facing) return;
        facing = dir;
        gsap.to(turn, { s: dir, duration: TURN_TIME, ease: "power2.inOut", overwrite: true });
      }

      function stopRunning() {
        v = 0;
        moving = false;
        runningOn = false;
        set("running", false);
      }

      function grab() {
        holding = true;
        grip.x = gripPrevX = pointer!.x;
        grip.y = pointer!.y;
        stopRunning();
        set("waiting", false);
        set("holding", true);
        leaping = true;
        // Rises fast, drifts across: an arc, not a straight slide.
        gsap.killTweensOf(lift);
        gsap
          .timeline({
            onComplete: () => {
              leaping = false;
              // Pulled away mid-jump: it grabs at thin air and drops.
              const gone = !inBand(pointer) || !roomToHang(pointer, HANG_SLACK) || Math.hypot(pointer!.x - grip.x, pointer!.y - grip.y) > catW * CATCH;
              if (holding && gone) {
                letGo();
                sulkUntil = gsap.ticker.time + SLIPPED_PAUSE;
              }
            },
          })
          .to(lift, { y: 1, duration: LEAP, ease: "power3.out" }, 0)
          .to(lift, { x: 1, duration: LEAP, ease: "sine.inOut" }, 0);
      }

      function letGo() {
        holding = false;
        leaping = false;
        set("holding", false);
        // Drop straight down to the floor under where it was hanging.
        const pawX = facing === 1 ? PAW.x : 1 - PAW.x;
        const hangLeft = grip.x - catW * pawX;
        x = Math.min(Math.max(hangLeft + catW * FOOT.x, minX()), maxX());
        gsap.killTweensOf(lift);
        gsap.to(lift, {
          x: 0,
          y: 0,
          duration: 0.35,
          ease: "power2.in",
          // Lands with a little weight.
          onComplete: () => {
            gsap
              .timeline()
              .to(squash, { s: LAND_SQUASH, duration: 0.07, ease: "power2.out" })
              .to(squash, { s: 1, duration: 0.2, ease: "back.out(3)" });
          },
        });
      }

      // A click anywhere in the stage makes the cat lose its grip (the
      // starburst itself is site-wide, from ClickBurst.astro). Links and
      // hotspots underneath still get the click.
      window.addEventListener("pointerdown", (e) => {
        const at = { x: e.clientX - stage.left, y: e.clientY - stage.top };
        if (!inBand(at)) return;
        if (holding) {
          letGo();
          sulkUntil = gsap.ticker.time + DROPPED_PAUSE;
        }
      });

      /** Ease `v` toward `want` (px/s) without exceeding ACCEL. */
      function steer(want: number, dt: number) {
        const step = ACCEL * stage.width * dt;
        v += Math.max(-step, Math.min(step, want - v));
      }

      /** The swing spring, pulled toward `target` degrees. */
      function swing(target: number, dt: number) {
        sway.va += ((target - sway.a) * SWAY_STIFF - sway.va * SWAY_DAMP) * dt;
        sway.a = Math.max(-SWAY_MAX, Math.min(SWAY_MAX, sway.a + sway.va * dt));
        // Settle fully instead of creeping toward 0 forever.
        if (target === 0 && Math.abs(sway.a) < 0.01 && Math.abs(sway.va) < 0.05) sway.a = sway.va = 0;
      }

      // Rive's free-plan export opens with a few seconds of its watermark
      // splash, drawn as an opaque square over the whole canvas. Keep the
      // cat parked in its corner until that's gone, so the splash doesn't
      // go chasing the cursor around the stage. Detected from the canvas
      // corners: opaque while the splash shows, transparent once it's gone
      // (the cat's artboard has no fill). If no splash shows up in the first
      // moment (a paid-plan export), it wakes straight away; either way it's
      // capped so it can't wait forever.
      let awake = false;
      const NO_SPLASH_AFTER = 1;
      const WAKE_MAX = 14;
      const pixels = canvas!.getContext("2d");
      const startedAt = gsap.ticker.time;
      let splashSeen = false;
      (function checkSplash() {
        const elapsed = gsap.ticker.time - startedAt;
        let covered: boolean | null = null;
        try {
          const w = canvas!.width;
          const h = canvas!.height;
          covered = !!pixels && [
            [2, 2],
            [w - 3, 2],
            [2, h - 3],
            [w - 3, h - 3],
          ].some(([px, py]) => pixels.getImageData(px, py, 1, 1).data[3] > 0);
        } catch {
          // Can't read the canvas: fall back to the time cap.
        }
        if (covered) splashSeen = true;
        const done =
          (splashSeen && covered === false) ||
          (!splashSeen && covered === false && elapsed > NO_SPLASH_AFTER) ||
          elapsed > WAKE_MAX;
        if (done) awake = true;
        else gsap.delayedCall(0.2, checkSplash);
      })();

      gsap.ticker.add((time, deltaMs) => {
        const dt = Math.min(deltaMs, 50) / 1000;

        if (!awake) {
          place();
          return;
        }

        // Hanging on: its grip trails the cursor. It lets go the moment the
        // cursor leaves the stage, and slips off if the cursor yanks away
        // faster than it can follow. Being dragged sideways swings it.
        if (holding) {
          if (leaping) {
            // Airborne: it can't change course, so the grip stays put.
          } else if (!inBand(pointer) || !roomToHang(pointer, HANG_SLACK)) {
            letGo();
          } else {
            const k = 1 - Math.pow(1 - GRIP_FOLLOW, dt * 60);
            grip.x += (pointer!.x - grip.x) * k;
            grip.y += (pointer!.y - grip.y) * k;
            if (Math.hypot(pointer!.x - grip.x, pointer!.y - grip.y) > catW * SLIP) {
              letGo();
              sulkUntil = time + SLIPPED_PAUSE;
            }
          }
          const dragSpeed = dt > 0 ? (grip.x - gripPrevX) / dt / stage.width : 0;
          gripPrevX = grip.x;
          swing(holding && !leaping ? dragSpeed * SWAY_GAIN : 0, dt);
          place();
          return;
        }
        swing(0, dt);

        // Just got shaken off (or still falling): sit tight for a moment.
        if (time < sulkUntil || lifted()) {
          stopRunning();
          set("waiting", false);
          place();
          return;
        }

        // Where it wants to be. Inside the stage: front paws under the
        // cursor, turning around only once the cursor is clearly behind it.
        // Outside: the nearest spot along the floor.
        const inside = inBand(pointer);
        const reach = (PAW.x - FOOT.x) * catW;
        let want = facing;
        let aim = x;
        if (pointer && inside) {
          if ((pointer.x - x) * facing < -catW * TURN_MARGIN) want = -facing;
          aim = pointer.x - want * reach;
        } else if (pointer) {
          aim = pointer.x;
          if (Math.abs(aim - x) > catW * START_DIST) want = aim > x ? 1 : -1;
        }
        // Within reach of its body (any direction) with room to hang: pounce,
        // after turning to face it if it's behind.
        if (pointer && inside && roomToHang(pointer)) {
          const b = body();
          if (Math.hypot(pointer.x - b.x, pointer.y - b.y) < POUNCE_RADIUS * catW) {
            const side = Math.abs(pointer.x - b.x) < catW * TURN_MARGIN ? facing : Math.sign(pointer.x - b.x);
            if (side === facing) {
              grab();
              place();
              return;
            }
            want = side;
            aim = x;
          }
        }
        const target = Math.min(Math.max(aim, minX()), maxX());
        const dx = target - x;

        // (Inside the stage a short deadband, so it never sits stuck just
        // out of reach.)
        const startDist = inside ? 0.04 : START_DIST;
        if (!moving && Math.abs(dx) > catW * startDist) moving = true;

        // Needs to turn: brake first, then turn on the spot.
        let wantV = 0;
        if (want !== facing) {
          if (Math.abs(v) < RUN_OFF * stage.width) turnTo(want);
        } else if (moving) {
          // Cruise, then brake on a curve that stops right at the target.
          wantV = Math.sign(dx) * Math.min(MAX_SPEED * stage.width, Math.sqrt(2 * BRAKE * stage.width * Math.abs(dx)));
        }
        steer(wantV, dt);

        // Never run past the target.
        // Even speed along the curve, not just across it.
        const next = x + v * dt * Math.cos(surface(x).tilt);
        if (moving && Math.sign(target - next) !== Math.sign(dx)) {
          x = target;
          v = 0;
        } else {
          x = Math.min(Math.max(next, minX()), maxX());
        }
        if (moving && Math.abs(target - x) <= ARRIVE && Math.abs(v) < RUN_OFF * stage.width) {
          moving = false;
          v = 0;
        }

        // Run cycle on/off with a gap between the thresholds, so it
        // doesn't flicker; `waiting` only once it has properly stopped.
        const speed = Math.abs(v) / stage.width;
        if (!runningOn && speed > RUN_ON) runningOn = true;
        else if (runningOn && speed < RUN_OFF) runningOn = false;
        set("running", runningOn);
        set("waiting", !runningOn && !moving && !inside && !!pointer);
        place();
      });
    }
  }
</script>
