---
/**
 * The Rive cat that lives in the hero's top coral band (public/rive/cat.riv,
 * artboard + state machine both "Cat"). Rive owns how the cat moves; this
 * script owns where it is:
 *
 *  - cursor inside the band → run over, pounce, and hang from the cursor
 *  - cursor outside the band → run to the nearest edge and wait there
 *
 * The state machine reads three View Model booleans (`running`, `waiting`,
 * `holding`) plus a `blink` trigger fired at random. Clicking in the band
 * sets off a little line starburst and makes the cat let go. Touch screens get a
 * sitting cat; reduced motion gets a still one.
 *
 * Positions are in canvas units (see ./canvas.ts) so the cat scales with
 * the cover. BAND matches the coral band drawn in Hero.astro.
 */
import { canvasStyle } from "./canvas";

const BAND = { x: 42, y: 43, width: 1355, height: 329 };
/** Height of the cat's canvas, in canvas units. */
const CAT_H = 280;
---

<div class="hero-cat" data-hero-cat style={canvasStyle(BAND)}>
  <canvas class="hero-cat__canvas" data-hero-cat-canvas style={`--cat-h: ${CAT_H}`} aria-hidden="true"></canvas>
</div>

<style>
  /* Fills the band so the script can measure it; clicks pass through to
     the hotspots and links underneath. */
  .hero-cat {
    pointer-events: none;
    /* The band is a comic panel: a cat hanging low gets cut off at its
       edge instead of spilling onto the cover below. */
    overflow: hidden;
    z-index: 6;
  }

  .hero-cat__canvas {
    position: absolute;
    left: 0;
    top: 0;
    height: calc(var(--cat-h) * var(--u, 1px));
    /* Width is set from the artboard's aspect ratio once the file loads. */
    width: 0;
    visibility: hidden;
    will-change: transform;
  }

  .hero-cat__canvas.is-ready {
    visibility: visible;
  }
</style>

<script>
  import { Rive, Layout, Fit, Alignment, RuntimeLoader } from "@rive-app/canvas";
  import riveWasm from "@rive-app/canvas/rive.wasm?url";
  import { gsap, prefersReducedMotion } from "../../scripts/gsap-setup.js";

  // Self-host the runtime instead of pulling it from a CDN.
  RuntimeLoader.setWasmUrl(riveWasm);

  /**
   * Where things sit in the artboard, as fractions of its width/height.
   * FOOT is the point that stands on the band's floor; PAW is the point
   * pinned to the cursor while hanging (the hang animation's pivot).
   */
  const FOOT = { x: 0.49, y: 0.9 };
  /** `wait` crouches with its feet higher up the artboard than the others. */
  const WAIT_FOOT_Y = 0.812;
  const PAW = { x: 0.82, y: 0.16 };
  /** Gap between the feet and the band's bottom edge, as a share of band height. */
  const FLOOR_INSET = 0.04;
  /** Run speed, in band widths per second. */
  const RUN_SPEED = 0.42;
  /** How close (share of cat width) its front paws must get to the
   *  cursor, horizontally, before it pounces. */
  const GRAB_RANGE = 0.08;
  /** How close (px) counts as "arrived" when heading for a target. */
  const ARRIVE = 3;
  /** How long the leap from the floor to the cursor takes (match `pounce`). */
  const LEAP = 0.45;
  /** After being shaken off by a click, the cat sulks this long (s)
   *  before it chases again. */
  const DROPPED_PAUSE = 1.2;
  /** While hanging, how quickly the cat's grip catches up with the cursor
   *  (share of the gap closed per 60fps frame). Lower = heavier cat. */
  const GRIP_FOLLOW = 0.3;
  /** If the cursor gets this far ahead of its grip (share of cat width),
   *  the cat loses hold and falls. */
  const SLIP = 0.3;
  /** At the end of a pounce, the cursor must still be this close to where
   *  the cat jumped (share of cat width) for it to catch on. */
  const CATCH = 0.18;
  /** Pause after slipping off or missing, before it chases again (s). */
  const SLIPPED_PAUSE = 0.5;

  const host = document.querySelector<HTMLElement>("[data-hero-cat]");
  const canvas = host?.querySelector<HTMLCanvasElement>("[data-hero-cat-canvas]");

  if (host && canvas) {
    const still = prefersReducedMotion();
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    const rive = new Rive({
      src: "/rive/cat.riv",
      canvas,
      artboard: "Cat",
      stateMachine: "Cat",
      autoplay: !still,
      autoBind: true,
      layout: new Layout({ fit: Fit.Contain, alignment: Alignment.Center }),
      onLoad: () => start(),
    });

    function start() {
      const b = rive.bounds;
      const aspect = (b.maxX - b.minX) / (b.maxY - b.minY);
      canvas!.style.aspectRatio = String(aspect);
      canvas!.style.width = "auto";

      const vm = rive.viewModelInstance;
      const input = {
        running: vm?.boolean("running"),
        waiting: vm?.boolean("waiting"),
        holding: vm?.boolean("holding"),
        blink: vm?.trigger("blink"),
      };
      const foot = { y: FOOT.y };
      const set = (name: "running" | "waiting" | "holding", on: boolean) => {
        const prop = input[name];
        if (!prop || prop.value === on) return;
        prop.value = on;
        // Slide the floor line along with the state machine's blend.
        if (name === "waiting") gsap.to(foot, { y: on ? WAIT_FOOT_Y : FOOT.y, duration: 0.15, overwrite: true });
      };

      // Sizes, re-measured on resize.
      let band = host!.getBoundingClientRect();
      let catW = 0;
      let catH = 0;
      function measure() {
        band = host!.getBoundingClientRect();
        catW = canvas!.offsetWidth;
        catH = canvas!.offsetHeight;
        rive.resizeDrawingSurfaceToCanvas();
      }
      measure();

      // The cat's state, in px relative to the band's top-left.
      const floorY = () => band.height * (1 - FLOOR_INSET);
      const minX = () => catW * FOOT.x;
      const maxX = () => band.width - catW * (1 - FOOT.x);
      let x = band.width * 0.5;
      let facing = 1;
      /** 0 = standing on the floor, 1 = hanging from the cursor. */
      const lift = { v: 0 };
      let holding = false;
      /** Mid-pounce: committed to where the cursor was when it jumped. */
      let leaping = false;
      /** gsap time until which the cat sits out after being dropped. */
      let sulkUntil = 0;
      let pointer: { x: number; y: number } | null = null;
      /** Where its paws are hanging on: trails the cursor while held. */
      const grip = { x: 0, y: 0 };

      function place() {
        // Standing: FOOT on the floor at x. Hanging: PAW on the cursor.
        const groundLeft = x - catW * FOOT.x;
        const groundTop = floorY() - catH * foot.y;
        let left = groundLeft;
        let top = groundTop;
        if (lift.v > 0) {
          const pawX = facing === 1 ? PAW.x : 1 - PAW.x;
          const hangLeft = grip.x - catW * pawX;
          const hangTop = grip.y - catH * PAW.y;
          left = groundLeft + (hangLeft - groundLeft) * lift.v;
          top = groundTop + (hangTop - groundTop) * lift.v;
        }
        canvas!.style.transform = `translate(${left}px, ${top}px) scaleX(${facing})`;
      }

      place();
      canvas!.classList.add("is-ready");

      if (still) return;

      // Blink every few seconds, at uneven intervals.
      (function blinkLater() {
        gsap.delayedCall(2 + Math.random() * 4, () => {
          input.blink?.trigger();
          blinkLater();
        });
      })();

      // Touch screens: no cursor to chase, so the cat just sits.
      if (!canHover) return;

      // Cursor in client px; `pointer` is re-derived from it whenever the
      // band moves under a still cursor (scrolling).
      let client: { x: number; y: number } | null = null;
      const track = () => {
        pointer = client && { x: client.x - band.left, y: client.y - band.top };
      };
      window.addEventListener(
        "pointermove",
        (e) => {
          client = { x: e.clientX, y: e.clientY };
          track();
        },
        { passive: true },
      );
      document.documentElement.addEventListener("pointerleave", () => {
        client = null;
        track();
      });
      window.addEventListener(
        "scroll",
        () => {
          band = host!.getBoundingClientRect();
          track();
        },
        { passive: true },
      );
      window.addEventListener("resize", () => {
        measure();
        x = Math.min(Math.max(x, minX()), maxX());
      });

      const inBand = (p: { x: number; y: number } | null) =>
        !!p && p.x >= 0 && p.x <= band.width && p.y >= 0 && p.y <= band.height;

      function grab() {
        holding = true;
        grip.x = pointer!.x;
        grip.y = pointer!.y;
        set("running", false);
        set("waiting", false);
        set("holding", true);
        leaping = true;
        gsap.to(lift, {
          v: 1,
          duration: LEAP,
          ease: "power2.out",
          overwrite: true,
          onComplete: () => {
            leaping = false;
            // Pulled away mid-jump: it grabs at thin air and drops.
            const gone = !inBand(pointer) || Math.hypot(pointer!.x - grip.x, pointer!.y - grip.y) > catW * CATCH;
            if (holding && gone) {
              letGo();
              sulkUntil = gsap.ticker.time + SLIPPED_PAUSE;
            }
          },
        });
      }

      function letGo() {
        holding = false;
        leaping = false;
        set("holding", false);
        // Drop straight down to the floor under where it was hanging.
        const pawX = facing === 1 ? PAW.x : 1 - PAW.x;
        const hangLeft = grip.x - catW * pawX;
        x = Math.min(Math.max(hangLeft + catW * FOOT.x, minX()), maxX());
        gsap.to(lift, { v: 0, duration: 0.35, ease: "power2.in", overwrite: true });
      }

      // A click anywhere in the band: a starburst where it landed, and the
      // cat loses its grip. Links and hotspots underneath still get the click.
      window.addEventListener("pointerdown", (e) => {
        const at = { x: e.clientX - band.left, y: e.clientY - band.top };
        if (!inBand(at)) return;
        burst(at);
        if (holding) {
          letGo();
          sulkUntil = gsap.ticker.time + DROPPED_PAUSE;
        }
      });

      function burst(at: { x: number; y: number }) {
        const NS = "http://www.w3.org/2000/svg";
        const size = Math.max(36, band.height * 0.22);
        const svg = document.createElementNS(NS, "svg");
        svg.setAttribute("viewBox", "-50 -50 100 100");
        svg.setAttribute("aria-hidden", "true");
        Object.assign(svg.style, {
          position: "absolute",
          left: `${at.x - size / 2}px`,
          top: `${at.y - size / 2}px`,
          width: `${size}px`,
          height: `${size}px`,
          overflow: "visible",
          pointerEvents: "none",
        });
        const RAYS = 8;
        const lines: SVGLineElement[] = [];
        for (let i = 0; i < RAYS; i++) {
          const a = (i / RAYS) * Math.PI * 2 + (Math.random() - 0.5) * 0.25;
          const line = document.createElementNS(NS, "line");
          // Alternate long and short rays, comic-style.
          const len = i % 2 ? 0.7 : 1;
          line.dataset.cos = String(Math.cos(a) * len);
          line.dataset.sin = String(Math.sin(a) * len);
          line.setAttribute("stroke", "var(--color-cream)");
          line.setAttribute("stroke-width", "6");
          line.setAttribute("stroke-linecap", "round");
          svg.append(line);
          lines.push(line);
        }
        host!.append(svg);

        // Each ray shoots outward: its head leads, its tail catches up. They
        // start off-centre and the tail leaves right away, so the middle
        // clears almost instantly instead of clumping into a blob.
        const ray = { head: 20, tail: 16 };
        const draw = () => {
          for (const line of lines) {
            const c = Number(line.dataset.cos);
            const sn = Number(line.dataset.sin);
            line.setAttribute("x1", String(c * ray.tail));
            line.setAttribute("y1", String(sn * ray.tail));
            line.setAttribute("x2", String(c * ray.head));
            line.setAttribute("y2", String(sn * ray.head));
          }
        };
        draw();
        gsap
          .timeline({ onUpdate: draw, onComplete: () => svg.remove() })
          .to(ray, { head: 50, duration: 0.24, ease: "power3.out" }, 0)
          .to(ray, { tail: 48, duration: 0.3, ease: "power1.inOut" }, 0);
      }

      gsap.ticker.add((time, deltaMs) => {
        const dt = Math.min(deltaMs, 50) / 1000;

        // Just got shaken off: sit tight for a moment.
        if (time < sulkUntil) {
          set("running", false);
          set("waiting", false);
          place();
          return;
        }

        // Hanging on: its grip trails the cursor. It lets go the moment the
        // cursor leaves the band, and slips off if the cursor yanks away
        // faster than it can follow.
        if (holding) {
          if (leaping) {
            // Airborne: it can't change course, so the grip stays put.
          } else if (!inBand(pointer)) {
            letGo();
          } else {
            const k = 1 - Math.pow(1 - GRIP_FOLLOW, dt * 60);
            grip.x += (pointer!.x - grip.x) * k;
            grip.y += (pointer!.y - grip.y) * k;
            if (Math.hypot(pointer!.x - grip.x, pointer!.y - grip.y) > catW * SLIP) {
              letGo();
              sulkUntil = time + SLIPPED_PAUSE;
            }
          }
          place();
          return;
        }

        // Inside: run until its front paws are under the cursor. Outside:
        // the nearest edge of the band.
        const inside = inBand(pointer);
        const reach = (PAW.x - FOOT.x) * catW;
        const side = pointer && pointer.x < x ? -1 : 1;
        const aim = pointer ? (inside ? pointer.x - side * reach : pointer.x) : x;
        const target = Math.min(Math.max(aim, minX()), maxX());
        const dx = target - x;
        const paws = x + side * reach;

        if (inside && Math.abs(pointer!.x - paws) < catW * GRAB_RANGE && lift.v === 0) {
          facing = side;
          grab();
          place();
          return;
        }

        if (Math.abs(dx) > ARRIVE && lift.v === 0) {
          facing = dx > 0 ? 1 : -1;
          x += Math.sign(dx) * Math.min(Math.abs(dx), RUN_SPEED * band.width * dt);
          set("running", true);
          set("waiting", false);
        } else {
          set("running", false);
          set("waiting", !inside && !!pointer);
        }
        place();
      });
    }
  }
</script>
