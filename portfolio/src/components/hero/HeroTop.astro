---
/**
 * The hero's top panel: a night sky over a cream planet, with the greeting,
 * the name, a rocket parked on the ground, and the traits pill. It's the
 * stage for the Rive cat (HeroCat.astro), which runs along the ground.
 *
 * The traits pill starts hidden. The first time the cat runs past it, the
 * pill is drawn in behind the cat as a halftone patch (the same dot screen
 * as the nav bar's trail) and the words appear with it. HeroCat reports its
 * position with a `herocat:move` event, or `herocat:reveal` when it won't be
 * running (touch screens, reduced motion).
 *
 * Coordinates are Figma canvas units (see ./canvas.ts), from the "top
 * section" of the landing frame.
 */
import { hero } from "../../content/hero";
import { canvasStyle, css, u } from "./canvas";
import Sparkle from "./Sparkle.astro";
import rocket from "../../assets/illustrations/hero-rocket.svg";

const BAND = { x: 42, y: 43, width: 1355, height: 249 };
/** Figma's pill is 335 × 34 at (547, 195); drawn a little wider (×1.07)
 *  and taller (×1.3) about its centre. */
const PILL = { x: 535.5, y: 190, width: 358, height: 44 };
const traits = hero.traits.join(" ✦ ");
---

<div class="hero-top absolute bg-ink" style={canvasStyle(BAND)}>
  <!-- The planet: one big ellipse, cropped by the panel. -->
  <svg class="hero-top__ground" viewBox={`0 0 ${BAND.width} ${BAND.height}`} preserveAspectRatio="none" aria-hidden="true">
    <ellipse cx="679" cy="288" rx="763" ry="113" fill="white"></ellipse>
  </svg>

  <!-- Positions are relative to the panel. -->
  <Sparkle variant="d" x={59} y={74} size={25} idleDelay={0.3} />
  <Sparkle variant="d" x={1100} y={26} size={21} idleDelay={1.1} />
  <Sparkle variant="d" x={1337} y={118} size={38} idleDelay={1.9} />

  <!-- Figma's rotated rocket: a 65 × 162 drawing tipped 8.62° inside an
       89 × 170 box at (1202, 93). -->
  <div class="absolute flex items-center justify-center" style={canvasStyle({ x: 1160, y: 50, width: 88.971, height: 169.515 })}>
    <img
      src={rocket.src}
      alt=""
      style={css({ width: u(65.494), height: u(161.521), transform: "rotate(8.62deg)" })}
    />
  </div>
</div>

<p
  class="hero-top__text absolute text-center font-script text-white"
  style={css({ left: u(421), top: u(74), width: u(600), fontSize: u(32), lineHeight: "0.91" })}
  data-anim="greeting"
>
  {hero.greeting}
</p>

<h1
  class="hero-top__text hero-top__name absolute text-center font-display uppercase text-white"
  style={css({ left: u(266), top: u(103), width: u(907), fontSize: u(96), lineHeight: "0.91" })}
>
  <span class="block" data-anim="headline-line">{hero.nameLines.join(" ")}</span>
</h1>

<div class="hero-top__text hero-pill absolute" style={canvasStyle(PILL)} data-hero-pill>
  <canvas class="hero-pill__dots" data-hero-pill-dots aria-hidden="true"></canvas>
  <p class="hero-pill__words font-script text-white" style={css({ fontSize: u(24) })} data-hero-pill-words>
    {traits}
  </p>
</div>

<style>
  .hero-top {
    overflow: hidden;
  }

  .hero-top__ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Under the cat (z 6), over the panel. */
  .hero-top__text {
    z-index: 5;
    margin: 0;
  }

  .hero-top__name {
    white-space: nowrap;
    text-shadow:
      calc(10 * var(--u)) calc(8 * var(--u)) 0 var(--color-ink),
      calc(17 * var(--u)) calc(8 * var(--u)) 0 var(--color-ink);
  }

  .hero-pill {
    display: grid;
    place-items: center;
  }

  /* Bleeds past the pill so the dots can fade out softly at its edges. */
  .hero-pill__dots {
    position: absolute;
    inset: -20%  -4%;
    width: 108%;
    height: 140%;
  }

  .hero-pill__words {
    position: relative;
    margin: 0;
    line-height: 1;
    white-space: nowrap;
  }

  /* Hidden until the cat draws it in (only when the script can do that). */
  :global(html.js) .hero-pill__words {
    clip-path: inset(-50% 100% -50% 0);
  }
</style>

<script>
  import { prefersReducedMotion } from "../../scripts/gsap-setup.js";

  const pill = document.querySelector<HTMLElement>("[data-hero-pill]");
  const canvas = pill?.querySelector<HTMLCanvasElement>("[data-hero-pill-dots]");
  const words = pill?.querySelector<HTMLElement>("[data-hero-pill-words]");
  const ctx = canvas?.getContext("2d");

  if (pill && canvas && words && ctx) {
    /** Dot spacing as a share of the pill's height. */
    const PITCH = 0.2;
    /** Largest dot radius as a share of the pitch (neighbours kiss at 0.6). */
    const MAX_R = 0.6;
    /** Ink at the pill's middle line. 1 = dots just touching; ~1.45 closes
     *  the gaps between them, so the words sit on near-solid teal. */
    const CORE_INK = 1.4;
    /** Screen angle, matching the nav trail's teal screen. */
    const ANGLE = (15 * Math.PI) / 180;
    /** How long each dot takes to pop in once the cat passes it (ms). */
    const POP = 220;

    const color = getComputedStyle(document.documentElement).getPropertyValue("--color-teal-deep").trim() || "#00767e";

    type Dot = { x: number; y: number; r: number; born: number };
    let dots: Dot[] = [];
    let width = 0;
    let height = 0;
    /** Where the pill itself sits inside the (bleeding) canvas. */
    let box = { x: 0, y: 0, w: 0, h: 0 };
    /** The stretch that's been drawn so far, in canvas px. */
    let lo = Infinity;
    let hi = -Infinity;
    let lastCatX: number | null = null;

    function layout() {
      const rect = canvas!.getBoundingClientRect();
      const pillRect = pill!.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const oldWidth = width;
      width = rect.width;
      height = rect.height;
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      box = { x: pillRect.left - rect.left, y: pillRect.top - rect.top, w: pillRect.width, h: pillRect.height };

      // A rotated dot grid; each dot's size comes from how deep inside the
      // pill's rounded outline it sits, so the patch fades out at the edge.
      const pitch = box.h * PITCH;
      const cos = Math.cos(ANGLE);
      const sin = Math.sin(ANGLE);
      const reach = Math.hypot(width, height);
      const radius = box.h / 2;
      const fade = box.h * 0.42;
      dots = [];
      for (let i = -reach / pitch; i < reach / pitch; i++) {
        for (let j = -reach / pitch; j < reach / pitch; j++) {
          const x = i * pitch * cos - j * pitch * sin;
          const y = i * pitch * sin + j * pitch * cos;
          if (x < 0 || x > width || y < 0 || y > height) continue;
          // Signed distance to the rounded rectangle (positive = inside).
          const qx = Math.abs(x - (box.x + box.w / 2)) - (box.w / 2 - radius);
          const qy = Math.abs(y - (box.y + box.h / 2)) - (box.h / 2 - radius);
          const outside = Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0);
          const depth = radius - outside;
          // A little unevenness, like ink on paper.
          // Ink builds toward the middle line, past "dots just touching"
          // (1) to nearly solid (CORE_INK) behind the words, so they read
          // clearly. The unevenness only roughs up the lighter edges.
          const base = Math.min(CORE_INK, (depth + box.h * 0.06) / fade);
          const ink = base + (Math.random() - 0.5) * 0.12 * Math.max(0, 1 - base);
          if (ink <= 0.08) continue;
          dots.push({ x, y, r: pitch * MAX_R * Math.sqrt(ink), born: NaN });
        }
      }
      // Re-laying out (resize) keeps whatever was already drawn.
      if (oldWidth && hi >= lo) {
        lo *= width / oldWidth;
        hi *= width / oldWidth;
      }
      stamp(0);
      draw();
    }

    /** Mark every dot in the drawn stretch as born (instantly, if `at` is 0). */
    function stamp(at: number) {
      for (const d of dots) if (Number.isNaN(d.born) && d.x >= lo && d.x <= hi) d.born = at;
    }

    function draw() {
      const now = performance.now();
      let busy = false;
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = color;
      ctx!.beginPath();
      for (const d of dots) {
        if (Number.isNaN(d.born)) continue;
        const t = Math.min(1, (now - d.born) / POP);
        if (t < 1) busy = true;
        // Pops slightly past full size, then settles.
        const s = t < 1 ? 1 + 0.25 * Math.sin(t * Math.PI) - (1 - t) : 1;
        if (s <= 0) continue;
        ctx!.moveTo(d.x + d.r * s, d.y);
        ctx!.arc(d.x, d.y, d.r * s, 0, Math.PI * 2);
      }
      ctx!.fill();
      if (busy) requestAnimationFrame(draw);
    }

    function showWords() {
      if (hi < lo) return;
      const left = Math.max(0, lo - box.x);
      const right = Math.max(0, box.x + box.w - hi);
      words!.style.clipPath = `inset(-50% ${(right / box.w) * 100}% -50% ${(left / box.w) * 100}%)`;
    }

    function revealAll() {
      lo = 0;
      hi = width;
      stamp(prefersReducedMotion() ? 0 : performance.now());
      words!.style.clipPath = "none";
      requestAnimationFrame(draw);
    }

    // The cat's centre, in client px: widen the drawn stretch over the
    // ground it just covered, but only across the pill itself.
    window.addEventListener("herocat:move", (e) => {
      const clientX = (e as CustomEvent<{ clientX: number }>).detail.clientX;
      const x = clientX - canvas!.getBoundingClientRect().left;
      const prev = lastCatX ?? x;
      lastCatX = x;
      const a = Math.max(Math.min(prev, x), 0);
      const b = Math.min(Math.max(prev, x), width);
      if (a > b) return;
      const grew = a < lo || b > hi;
      if (!grew) return;
      lo = Math.min(lo, a);
      hi = Math.max(hi, b);
      // Once it's crossed the whole pill, the edges finish themselves.
      if (lo <= box.x && hi >= box.x + box.w) {
        lo = 0;
        hi = width;
      }
      stamp(performance.now());
      showWords();
      requestAnimationFrame(draw);
    });

    window.addEventListener("herocat:reveal", revealAll);

    layout();
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        layout();
        showWords();
      }, 120);
    });
  }
</script>
