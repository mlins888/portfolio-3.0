---
/** The tall teal "chess piece" / vase silhouette. */
import ArtAsset from "./ArtAsset.astro";
import type { CanvasBox } from "./canvas";

import vase from "../../assets/shapes/vase.svg";

const NATURAL = { w: 237, h: 556 };

interface Props extends CanvasBox {
  size?: number;
  class?: string;
}

const {
  size,
  color = "var(--color-teal)",
  class: className,
  ...box
} = Astro.props;
---

<ArtAsset
  svg={vase}
  natural={NATURAL}
  size={size}
  color={color}
  class={className}
  {...box}
/>
