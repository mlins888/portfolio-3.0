---
/**
 * One case-study card (Figma "Wireframe - work 3"): a tan frame holding a
 * rounded screenshot with the text below it, and two coloured layers
 * stacked under the frame. The whole card is a single link, and hovering
 * or focusing it lifts it slightly to show it's clickable.
 *
 * Sizes are in `cqi` of the surrounding .case-grid (see WorkSection.astro),
 * converted from Figma's pixels against its 1237px-wide row of cards, so
 * both cards' type matches and everything scales together. Each value has
 * a rem floor for when the cards stack on small screens.
 */
import { Image } from "astro:assets";
import type { CaseStudy } from "../../content/work";
import sparkle from "../../assets/decor/sparkle-divider.svg";

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<a
  class="case-card"
  id={study.id}
  href={study.href}
  style={`--aspect: ${study.imageAspect}; --focus-x: ${study.imageFocusX ?? "50%"};`}
>
  <div class="case-card__media">
    <Image
      class="case-card__image"
      src={study.image}
      alt={study.imageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 700px) 45vw, 90vw"
    />
  </div>

  <div class="case-card__panel">
    <h3 class="case-card__title font-body font-semibold">{study.title}</h3>
    <p class="case-card__meta font-body">
      <span>{study.role}</span>
      <img class="case-card__sparkle" src={sparkle.src} alt="" aria-hidden="true" width="30" height="24" />
      <span>{study.year}</span>
    </p>
    <p class="case-card__desc font-body font-light">{study.description}</p>
  </div>
</a>

<style>
  .case-card {
    /* All sizes are Figma pixels over its 1237px row of cards: tan frame
       radius 57, image inset ~38 sides / ~22 top, image radius ~36, green
       layer 14px and teal layer 33px below the frame. */
    --frame-radius: max(1.75rem, 4.6cqi);
    --inset-x: max(0.9rem, 3.1cqi);
    --inset-top: max(0.75rem, 1.8cqi);
    --layer-1: max(0.5rem, 1.13cqi);
    --layer-2: max(1.1rem, 2.67cqi);

    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--inset-top) var(--inset-x) max(1.25rem, 2.75cqi);
    background: var(--color-paper);
    border-radius: var(--frame-radius);
    box-shadow:
      0 var(--layer-1) 0 #00b781,
      0 var(--layer-2) 0 var(--color-teal-deep);
    color: var(--color-ink);
    text-decoration: none;
    scroll-margin-top: calc(var(--nav-offset) + 1.5rem);
    transition: transform 0.3s ease;
  }

  /* Side by side: each card grows in proportion to its image's aspect on
     top of a fixed basis equal to its two side insets, so both images come
     out exactly the same height. */
  @media (min-width: 700px) {
    .case-card {
      flex: var(--aspect) 1 calc(2 * var(--inset-x));
    }
  }

  .case-card:hover,
  .case-card:focus-visible {
    transform: translateY(max(-0.6rem, -0.75cqi));
  }

  .case-card:focus-visible {
    outline: 3px solid var(--color-cream);
    outline-offset: 4px;
  }

  .case-card__media {
    aspect-ratio: var(--aspect);
    overflow: hidden;
    border-radius: max(1.25rem, 2.9cqi);
  }

  .case-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-x) 50%;
  }

  .case-card__panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: max(1.5rem, 4.4cqi) 4% 0;
    text-align: center;
  }

  .case-card__title {
    margin: 0 0 max(0.6rem, 1cqi);
    font-size: clamp(1.5rem, 3.23cqi, 2.5rem);
    line-height: 0.91;
  }

  /* Role ✦ year, between two hairlines spanning ~70% of the frame. */
  .case-card__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: max(0.75rem, 1.5cqi);
    width: 82%;
    min-width: min(100%, 17rem);
    margin: 0 0 max(0.9rem, 1.55cqi);
    padding-block: max(0.5rem, 0.95cqi);
    border-block: 1px solid var(--color-ink);
    font-size: clamp(1rem, 1.94cqi, 1.5rem);
    line-height: 0.91;
  }

  .case-card__meta span {
    white-space: nowrap;
  }

  .case-card__sparkle {
    display: block;
    width: auto;
    height: 0.95em;
    flex: none;
  }

  .case-card__desc {
    margin: 0;
    max-width: 23em;
    font-size: clamp(0.95rem, 1.62cqi, 1.25rem);
    line-height: 0.91;
    /* Even line lengths, as in Figma — no single orphaned word. */
    text-wrap: balance;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card {
      transition: none;
    }

    .case-card:hover,
    .case-card:focus-visible {
      transform: none;
    }
  }
</style>
