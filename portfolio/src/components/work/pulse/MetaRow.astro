---
/**
 * Role / timeline / team / tools, as a row of short standalone tags — the
 * same PillBadge + coral/teal alternation the homepage case-study cards use
 * for their eyebrow pills ("2026", "Duke | Code+"), just at the small size
 * so a handful of them sit next to each other on one line instead of each
 * reading as its own headline.
 */
import PillBadge from "../../PillBadge.astro";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="meta-pills">
  {
    tags.map((tag, i) => (
      <li>
        <PillBadge label={tag} tone={i % 2 === 0 ? "coral" : "teal"} size="sm" />
      </li>
    ))
  }
</ul>

<style>
  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
