---
/**
 * Homepage Work section — case studies, other-project panels, playground CTA.
 */
import { work } from "../../content/work";
import CaseStudyCard from "./CaseStudyCard.astro";
import OtherProjectsScene from "./OtherProjectsScene.astro";
import PillBadge from "../PillBadge.astro";
---

<section
  id="work"
  class="work-section scroll-mt-[var(--nav-offset)]"
  aria-label="Selected work"
  data-work
>
  <div class="work-section__band">
    <div class="work-section__inner">
      <div class="case-grid">
        {work.caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>

      <!-- Heading + CTA sit on the surrounding coral background, not the
           tan panel underneath — that panel is only for the three project
           shapes, and cream-on-tan text was unreadable. -->
      <div class:list={["other-projects-group", { "other-projects-group--cta-only": !work.showOtherProjects }]}>
        {
          work.showOtherProjects && (
            <>
              <p class="other-projects-heading font-script">{work.otherProjectsHeading}</p>

              <div id="other-projects" class="other-projects" data-other-projects>
                <OtherProjectsScene />
              </div>
            </>
          )
        }

        <p id="playground-cta" class="playground-cta font-script">
          <span>{work.playgroundCta.before}</span>
          <PillBadge
            label={work.playgroundCta.pill}
            tone="teal"
            href={work.playgroundCta.href}
            size="lg"
          />
          <span>{work.playgroundCta.after}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .work-section {
    position: relative;
    background: var(--color-paper);
    padding-inline: clamp(0.75rem, 2.5vw, 2.5rem);
    /* Extra cream breathing room between the landing cover and this band,
       on top of the cover's own bottom margin. */
    padding-top: 3rem;
    padding-bottom: 0;
  }

  .work-section__band {
    /* The case-study row sizes itself against this band (see .case-grid). */
    container-type: inline-size;
    --band-pad-x: clamp(1rem, 3vw, 2.5rem);
    background: var(--color-coral);
    border-radius: 0;
    padding: clamp(3rem, 8vw, 6rem) var(--band-pad-x) clamp(3rem, 8vw, 6rem);
  }

  .work-section__inner {
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 10vw, 8rem);
  }

  /* The case-study cards, side by side. This is the container the cards
     size themselves against (cqi), standing in for Figma's 1237px row. */
  .case-grid {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: max(3.5rem, 2.72cqi);
    margin-top: clamp(0.5rem, 1.5vw, 1.5rem);
    /* Room for the stacked layers that hang below each card's panel. */
    padding-bottom: 2rem;
  }

  @media (min-width: 700px) {
    .case-grid {
      flex-direction: row;
      align-items: stretch;
      gap: 6.5cqi;
      /* Figma's row spans 1237 of the band's 1355px — wider than the
         section's text column — so break out of it, centred on the band. */
      --row-w: calc((100cqi + 2 * var(--band-pad-x)) * 0.913);
      width: var(--row-w);
      margin-inline: calc((100% - var(--row-w)) / 2);
    }
  }

  .other-projects-group {
    display: flex;
    flex-direction: column;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  /* Other projects hidden: only the playground line follows the cards, so
     drop the spacing that belonged to the heading/panels and tuck the line
     up closer (~80px below the cards' stacked layers at 1440px). */
  .other-projects-group--cta-only {
    margin-top: calc(-1 * clamp(1.5rem, 3.3vw, 3rem));
  }

  .other-projects-group--cta-only .playground-cta {
    margin-top: 0;
  }

  /* Phones: the project panels don't hold up at this size, so hide them
     (and their heading) and let the playground line follow the cards
     directly, spaced like the "cta only" variant above. */
  @media (max-width: 699px) {
    .other-projects-heading,
    .other-projects {
      display: none;
    }

    .other-projects-group {
      margin-top: calc(-1 * clamp(1.5rem, 3.3vw, 3rem));
    }

    .other-projects-group .playground-cta {
      margin-top: 0;
    }
  }

  .other-projects-heading {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 0.91;
    margin: 0 0 -6rem;
    padding-left: clamp(0rem, 1vw, 1rem);
    padding-right: clamp(1rem, 3vw, 2.5rem);
    color: var(--color-cream);
  }

  .playground-cta {
    scroll-margin-top: calc(var(--nav-offset) + 6rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem 0.85rem;
    font-size: clamp(1.35rem, 2.6vw, 2.5rem);
    line-height: 0.91;
    margin: 1.75rem 0 0;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
    text-align: right;
    color: var(--color-cream);
  }

  /* Match the pill's vertical size to the surrounding line of text, and give
     it the same "lifted card" hover treatment as the hero buildings (nudge
     up-left, hard-edged gold silhouette shows through behind it). */
  .playground-cta :global(.pill-badge) {
    /* Lifts the badge above the text baseline it sits on, without moving
       the surrounding text (the text's own box is untouched — this is a
       visual-only offset via transform). */
    --pill-lift: -0.52rem;
    padding-block: 0.4rem;
    line-height: 1.1;
    transition: transform 0.35s cubic-bezier(0.34, 1.4, 0.64, 1), filter 0.35s ease;
    transform: translateY(var(--pill-lift));
    filter: drop-shadow(0 0 0 transparent);
  }

  .playground-cta :global(.pill-badge):hover,
  .playground-cta :global(.pill-badge):focus-visible {
    transform: translate(-0.25rem, calc(var(--pill-lift) - 0.25rem));
    filter: drop-shadow(0.25rem 0.25rem 0 var(--color-gold));
  }

  .other-projects {
    position: relative;
    scroll-margin-top: calc(var(--nav-offset) + 1.5rem);
    margin-inline: calc(-1 * clamp(1rem, 3vw, 2.5rem));
  }

  /* The tan panel + its diagonal cut live on a background pseudo-element
     instead of directly on .other-projects — clip-path clips EVERY
     descendant of the element it's set on, and the scene's sparkles/
     starbursts are meant to poke out past the diagonal onto the coral
     behind it. Moving the clipped shape here keeps the tan panel's edge
     while leaving the real content (.scene and its decorations) unclipped. */
  .other-projects::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-paper);
    /* Coral wedges top + bottom to match the work-2 wireframe frame — top
       cut is inset on the left corner, bottom cut is inset on the LEFT
       corner too (not the right), so the right edge runs full-height. */
    clip-path: polygon(
      0 12.25rem,
      100% 0,
      100% 100%,
      0 calc(100% - 9.25rem)
    );
    box-shadow:
      0 -1.25rem 0 var(--color-coral),
      0 1.25rem 0 var(--color-coral);
  }

  .other-projects > :global(*) {
    position: relative;
    z-index: 1;
  }

</style>
