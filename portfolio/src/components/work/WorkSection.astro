---
/**
 * Homepage Work section — one bento grid of every project, tee and social
 * account (see BentoGrid.astro), over the starry sky (StarrySky.astro).
 */
import BentoGrid from "./BentoGrid.astro";
---

<section
  id="work"
  class="work-section scroll-mt-[var(--nav-offset)]"
  aria-label="Selected work"
  data-work
>
  <BentoGrid />
</section>

<style>
  .work-section {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem);
  }
</style>
