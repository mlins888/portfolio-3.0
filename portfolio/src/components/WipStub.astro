---
/**
 * "still workin on this one..." — the shared work-in-progress placeholder.
 *
 * Drop it anywhere a card, detail page, or panel has no real content yet:
 * the /work/[slug] detail stub, the video-game and social-media playground
 * cards, and any future error/empty state. Self-contained — the
 * writing-at-a-desk graphic drifts gently, a few sparkles twinkle around
 * it, and the Lakki line sits in a speech bubble (the same
 * src/assets/decor/speech-bubble.svg the hero buildings pop on hover, only
 * here it's always shown) — offset up and to the left of the art, bobbing
 * on its own slower timing so it reads as a separate floating element.
 *
 * All three idle loops are kept intentionally small and opt out under
 * prefers-reduced-motion.
 */
import { Image } from "astro:assets";
import wipArt from "../assets/decor/wip-stub.png";

interface Props {
  class?: string;
  /** Caption override — defaults to the house line. */
  caption?: string;
}

const { class: className, caption = "still workin on this one..." } = Astro.props;

// 4-point sparkle (same path as src/assets/decor/sparkle-a.svg), scattered
// around the art. Each: position, size, tint, twinkle stagger + tempo.
const SPARKLES = [
  { top: "2%", left: "6%", size: 30, color: "var(--color-coral)", delay: 0, dur: 2.4 },
  { top: "12%", right: "2%", size: 44, color: "var(--color-gold)", delay: 0.6, dur: 2.8 },
  { top: "54%", left: "-4%", size: 26, color: "var(--color-teal)", delay: 1.1, dur: 2.2 },
  { bottom: "6%", right: "8%", size: 34, color: "var(--color-coral)", delay: 1.5, dur: 2.6 },
];
---

<div class:list={["wip-stub", className]}>
  <div class="wip-stub__frame">
  <div class="wip-stub__bubble" role="text">
    <svg class="wip-stub__bubble-shape" viewBox="0 0 276.673 259.138" aria-hidden="true">
      <path
        d="M138.336 6C211.423 6 270.673 56.5625 270.673 118.935C270.673 150.014 255.96 178.161 232.155 198.581C234.354 218.359 242.755 246.34 265.062 253.414L179.139 226.398C166.287 229.95 152.574 231.869 138.336 231.869C65.2487 231.869 6 181.307 6 118.935C6.00005 56.5626 65.2488 6.00022 138.336 6Z"
        fill="var(--color-cream)"
      />
      <path
        d="M138.336 6V0H138.336L138.336 6ZM270.673 118.935H276.673V118.935L270.673 118.935ZM232.155 198.581L228.249 194.027L225.842 196.092L226.192 199.244L232.155 198.581ZM265.062 253.414L263.262 259.138L266.875 247.695L265.062 253.414ZM179.139 226.398L180.938 220.675L179.248 220.143L177.541 220.615L179.139 226.398ZM138.336 231.869L138.336 237.869H138.336V231.869ZM6 118.935L0 118.935V118.935H6ZM138.336 6V12C209.037 12 264.673 60.7332 264.673 118.935L270.673 118.935L276.673 118.935C276.673 52.3918 213.81 0 138.336 0V6ZM270.673 118.935H264.673C264.673 148.026 250.916 174.582 228.249 194.027L232.155 198.581L236.062 203.135C261.004 181.739 276.673 152.003 276.673 118.935H270.673ZM232.155 198.581L226.192 199.244C227.34 209.568 230.12 222.254 235.699 233.44C241.276 244.622 249.99 254.929 263.248 259.133L265.062 253.414L266.875 247.695C257.827 244.825 251.186 237.605 246.437 228.084C241.69 218.565 239.17 207.372 238.119 197.918L232.155 198.581ZM265.062 253.414L266.861 247.69L180.938 220.675L179.139 226.398L177.339 232.122L263.262 259.138L265.062 253.414ZM179.139 226.398L177.541 220.615C165.21 224.022 152.034 225.869 138.336 225.869V231.869V237.869C153.113 237.869 167.364 235.877 180.737 232.182L179.139 226.398ZM138.336 231.869L138.336 225.869C67.635 225.869 12 177.136 12 118.935H6H0C0 185.477 62.8624 237.869 138.336 237.869L138.336 231.869ZM6 118.935L12 118.935C12 60.7333 67.6351 12.0002 138.336 12L138.336 6L138.336 0C62.8624 0.000229359 5.53131e-05 52.392 0 118.935L6 118.935Z"
        fill="var(--color-ink)"
      />
    </svg>
    <p class="wip-stub__bubble-text font-script">{caption}</p>
  </div>

  <div class="wip-stub__art">
    <Image class="wip-stub__img" src={wipArt} alt="" widths={[320, 480, 640]} sizes="(min-width: 640px) 17rem, 55vw" />
    {
      SPARKLES.map((s) => (
        <svg
          class="wip-stub__sparkle"
          viewBox="0 0 78 82"
          width={s.size}
          height={s.size}
          aria-hidden="true"
          style={{
            top: s.top,
            left: s.left,
            right: s.right,
            bottom: s.bottom,
            color: s.color,
            "--idle-delay": `${s.delay}s`,
            "--idle-duration": `${s.dur}s`,
          }}
        >
          <path d="M0 42.3016C26 42.3016 36.8333 68.7672 39 82C39 51.2825 65 42.7355 78 42.3016C48.88 42.3016 39.8667 14.1005 39 0C39 29.1556 13 40.3492 0 42.3016Z" />
        </svg>
      ))
    }
  </div>
  </div>
</div>

<style>
  .wip-stub {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 3rem) 1rem;
    text-align: center;
  }

  /* Art + callout share this box; the callout is positioned against it.
     Left margin balances the bubble that hangs off the left edge so the
     pair still reads as centred. */
  .wip-stub__frame {
    position: relative;
    display: inline-flex;
    margin-left: clamp(1.5rem, 11vw, 4.75rem);
  }

  /* Persistent hero-style callout — offset up/left of the art so it isn't
     sitting on top of it, tail reaching down toward the character. */
  .wip-stub__bubble {
    position: absolute;
    bottom: 62%;
    right: 64%;
    width: clamp(8rem, 42vw, 12rem);
    z-index: 2;
    transform: rotate(-5deg);
    animation: wip-bubble-bob 4.6s ease-in-out infinite;
  }

  @keyframes wip-bubble-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-5deg);
    }
    50% {
      transform: translateY(-3px) rotate(-6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-stub__bubble {
      animation: none;
      transform: rotate(-5deg);
    }
  }

  .wip-stub__bubble-shape {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(3px 4px 0 color-mix(in srgb, var(--color-ink) 22%, transparent));
  }

  .wip-stub__bubble-text {
    position: absolute;
    /* Centred on the oval, above the tail. */
    top: 44%;
    left: 50%;
    width: 74%;
    transform: translate(-50%, -50%) rotate(1deg);
    margin: 0;
    font-size: clamp(1.05rem, 3vw, 1.5rem);
    line-height: 0.95;
    color: var(--color-ink);
  }

  .wip-stub__art {
    position: relative;
    display: inline-flex;
    /* Room for the sparkles that sit outside the art box. */
    margin-inline: 1.5rem;
    animation: wip-art-drift 5.4s ease-in-out infinite;
  }

  @keyframes wip-art-drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-stub__art {
      animation: none;
    }
  }

  .wip-stub__img {
    display: block;
    width: clamp(9rem, 55vw, 17rem);
    height: auto;
  }

  .wip-stub__sparkle {
    position: absolute;
    display: block;
    fill: currentColor;
    pointer-events: none;
    transform-origin: center;
    animation: wip-twinkle var(--idle-duration, 2.6s) ease-in-out infinite;
    animation-delay: var(--idle-delay, 0s);
  }

  @keyframes wip-twinkle {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.82);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-stub__sparkle {
      animation: none;
    }
  }
</style>
