---
/**
 * The rocket and its striped trail — the page's scroll progress bar.
 * Fixed flush under the nav: trail grows and the ship flies right as you scroll.
 * Geometry stays in hero-canvas units so it scales with the page.
 */
import RocketIcon from "./hero/RocketIcon.astro";
import StripedRibbon from "./hero/StripedRibbon.astro";
import { ROCKET_TRACK } from "./hero/canvas";

/** Ship SVG is tall; after the 90° rotation its visual height ≈ shipWidth.
 *  Offset so the ship's visual top sits flush with the ribbon / nav base. */
const shipNaturalH = 166.582;
const ribbonH = 40;
const shipTop = ROCKET_TRACK.shipWidth / 2 - shipNaturalH / 2;
---

<div class="rocket-progress" data-rocket-progress aria-hidden="true">
  <div class="rocket-progress__track">
    <div class="rocket-progress__trail">
      <StripedRibbon />
    </div>

    <div class="rocket-progress__ship">
      <RocketIcon size={ROCKET_TRACK.shipWidth} rotation={ROCKET_TRACK.shipRotation} />
      <!-- Small exhaust puffs off the tail, in teal/coral —
           a quiet detail, not a full particle system. -->
      <div class="rocket-progress__particles" aria-hidden="true">
        <span class="rocket-particle rocket-particle--teal" style="--particle-delay: 0s; --particle-y: -6px; --particle-drift: 5px;"></span>
        <span class="rocket-particle rocket-particle--coral" style="--particle-delay: 0.4s; --particle-y: 3px; --particle-drift: -4px;"></span>
        <span class="rocket-particle rocket-particle--teal" style="--particle-delay: 0.8s; --particle-y: 8px; --particle-drift: 3px;"></span>
        <span class="rocket-particle rocket-particle--coral" style="--particle-delay: 1.2s; --particle-y: -2px; --particle-drift: -6px;"></span>
      </div>
    </div>
  </div>
</div>

<style
  define:vars={{
    trackX: ROCKET_TRACK.x,
    trackW: ROCKET_TRACK.width,
    trailMin: ROCKET_TRACK.trailMin,
    trailMax: ROCKET_TRACK.trailMax,
    shipLead: ROCKET_TRACK.shipLead,
    shipTop,
    ribbonH,
  }}
>
  .rocket-progress {
    position: fixed;
    top: var(--nav-offset);
    left: 0;
    right: 0;
    height: 0;
    z-index: 40;
    container-type: inline-size;
    pointer-events: none;
  }

  .rocket-progress__track {
    --u: calc(100cqw / 1440);
    --progress: 0;
    --trail: calc(
      var(--trailMin) + var(--progress) * (var(--trailMax) - var(--trailMin))
    );

    position: absolute;
    top: 0;
    left: calc(var(--trackX) * var(--u));
    width: calc(var(--trackW) * var(--u));
    height: calc(var(--ribbonH) * var(--u));
  }

  .rocket-progress__trail {
    position: absolute;
    inset: 0;
    width: calc(var(--trail) * var(--u));
  }

  .rocket-progress__ship {
    position: absolute;
    top: calc(var(--shipTop) * var(--u));
    left: calc((var(--trail) + var(--shipLead)) * var(--u));
  }

  .rocket-progress__particles {
    position: absolute;
    /* Reuses --shipTop's own magnitude: rotating the tall, narrow icon box
       ~90° makes its visual tail reach that same distance past the box's
       own edge — see the shipTop comment above for the underlying math. */
    left: calc(var(--shipTop) * var(--u));
    top: 50%;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .rocket-particle {
    position: absolute;
    left: 0;
    top: var(--particle-y, 0);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    opacity: 0;
    animation: rocket-particle 1.6s ease-out infinite;
    animation-delay: var(--particle-delay, 0s);
  }

  .rocket-particle--teal {
    background: var(--color-teal);
  }

  .rocket-particle--coral {
    background: var(--color-coral);
  }

  @keyframes rocket-particle {
    0% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% - 16px), calc(-50% + var(--particle-drift, 4px))) scale(0.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rocket-particle {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, EASE, prefersReducedMotion } from "../scripts/gsap-setup.js";

  const bar = document.querySelector("[data-rocket-progress]");
  const track = bar?.querySelector(".rocket-progress__track");

  if (bar && track) {
    const reduced = prefersReducedMotion();
    const unit = () => bar.clientWidth / 1440;
    const scrolled = { progress: 0 };

    gsap.to(scrolled, {
      progress: 1,
      ease: "none",
      onUpdate: () =>
        track.style.setProperty("--progress", String(scrolled.progress)),
      scrollTrigger: {
        trigger: document.documentElement,
        start: "top top",
        // Not the "bottom bottom" shorthand: with `trigger:
        // document.documentElement`, GSAP resolves that against the
        // <html> element's own layout-box height (offsetHeight), which
        // undercounts on every page here — the footer's absolutely
        // positioned art (the cat illustration) extends the page's real
        // scrollable area (scrollHeight) well past that box. The gap was
        // 100+px, so the rocket maxed out — trail fully extended, ship
        // parked at its rightmost spot — well before the actual bottom of
        // the page. Computing end directly from the real scrollable
        // distance keeps the two in sync regardless of what any given
        // page's content does; the function form re-runs on every
        // ScrollTrigger.refresh(), including the automatic one on resize.
        end: () => document.documentElement.scrollHeight - window.innerHeight,
        scrub: reduced ? true : 0.5,
        invalidateOnRefresh: true,
      },
    });

    // Recomputes `end` above once webfonts swap in (font-display: swap
    // means the page can still reflow after ScrollTrigger's first
    // measurement) — a smaller effect than the footer one above, but the
    // same fix applies.
    document.fonts?.ready.then(() => ScrollTrigger.refresh());

    if (!reduced) {
      const ship = bar.querySelector('[data-anim="rocket"]');

      gsap.fromTo(
        ship,
        { opacity: 0, x: () => -160 * unit() },
        { opacity: 1, x: 0, duration: 1.1, ease: EASE.glide, delay: 0.45 },
      );
    }
  }
</script>
