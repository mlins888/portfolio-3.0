# Live data for the About page panels — see docs/about-panels.md
# .env is gitignored; copy this file to .env and fill in real values.
# Also add the same values in the Vercel project's Environment Variables.

# Spotify — "now playing" boombox panel
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam — "recently played game" controller panel.
# With an API key: set STEAM_API_KEY + STEAM_ID (SteamID64).
# Without a key: set STEAM_ID or STEAM_VANITY and make the profile's
# game details public — the public XML feed is used instead.
STEAM_API_KEY=
STEAM_ID=
STEAM_VANITY=

# Instagram — ONLY used locally by scripts/pull-instagram.mjs to download
# post images into src/assets/social/. Not needed on Vercel.
# One token per account you admin (Business/Creator accounts only), from
# developers.facebook.com → your app → Instagram → "API setup with Instagram
# login" → Generate access tokens. Tokens last ~60 days; regenerate there.
# The part after IG_TOKEN_ becomes the folder name (IG_TOKEN_DUKE_DESIGN →
# src/assets/social/duke-design/).
# IG_TOKEN_ACCOUNT_ONE=
# IG_TOKEN_ACCOUNT_TWO=
