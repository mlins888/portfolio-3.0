# Live data for the About page panels — see docs/about-panels.md
# .env is gitignored; copy this file to .env and fill in real values.
# Also add the same values in the Vercel project's Environment Variables.

# Spotify — "now playing" boombox panel
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam — "recently played game" controller panel.
# With an API key: set STEAM_API_KEY + STEAM_ID (SteamID64).
# Without a key: set STEAM_ID or STEAM_VANITY and make the profile's
# game details public — the public XML feed is used instead.
STEAM_API_KEY=
STEAM_ID=
STEAM_VANITY=
